#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/tunarr/tunarr
# @project KRATE
# @description Tunarr — linux-x64 tarball (rename binary, keep meilisearch) + ffmpeg + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_package
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port
	mkdir -p "${data_dir}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	mkdir -p "$(dirname "${env_file}")"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::fs::env::set "${env_file}" "TUNARR_BIND_ADDR" "127.0.0.1"
	zenfw::fs::env::set "${env_file}" "TUNARR_SERVER_PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_package
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_package() {
	local tmpdir bin
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	# Flat tarball: tunarr-v*-linux-x64 + meilisearch (or nested dir with same).
	if [[ -f "${tmpdir}/meilisearch" ]]; then
		mv -f "${tmpdir}/meilisearch" "${install_dir}/meilisearch"
	else
		bin="$(find "${tmpdir}" -type f -name meilisearch -print -quit 2>/dev/null || true)"
		[[ -n "${bin}" ]] && mv -f "${bin}" "${install_dir}/meilisearch"
	fi
	if [[ -f "${tmpdir}/tunarr" ]]; then
		bin="${tmpdir}/tunarr"
	else
		bin="$(find "${tmpdir}" -type f -name 'tunarr-*-linux-x64' -print -quit 2>/dev/null || true)"
		[[ -n "${bin}" ]] || bin="$(find "${tmpdir}" -type f -name 'tunarr*' ! -name '*.tar.gz' ! -name '*.exe' ! -name 'meilisearch' -print -quit 2>/dev/null || true)"
	fi
	[[ -n "${bin}" && -f "${bin}" ]] || {
		printf '[%s] tunarr binary missing after extract\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mv -f "${bin}" "${install_dir}/tunarr"
	chmod 0755 "${install_dir}/tunarr"
	[[ -f "${install_dir}/meilisearch" ]] && chmod 0755 "${install_dir}/meilisearch"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}
