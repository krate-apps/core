#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/x2go/x2go
# @project KRATE
# @description X2Go server — apt x2goserver + xfce4; oneshot verify (no web UI / no proxy; SSH client access).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::dependency::apt::install_inline "x2goserver" "x2goserver-xsession" "xfce4" || true
	command -v x2golistsessions >/dev/null 2>&1 || {
		printf '[%s] x2golistsessions missing after apt install\n' "${app_name}" >&2
		return 1
	}
	mkdir -p "${install_dir}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	# System-wide x2goserver is shared; enable if a unit exists (ignore failure on minimal installs).
	if systemctl list-unit-files x2goserver.service >/dev/null 2>&1; then
		systemctl enable --now x2goserver.service 2>/dev/null || true
	fi
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	_write_readme
	_write_verify
	# No web UI / no Caddy. Sessions are accepted over SSH by system x2goserver.
	zenfw::service::manage start "${service_unit}" 2>/dev/null || true
}

_update() {
	zenfw::dependency::apt::install_inline "x2goserver" "x2goserver-xsession" "xfce4" || true
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_write_readme() {
	cat >"${data_dir}/README" <<EOF
X2Go (KRATE)
============

Packages: x2goserver, x2goserver-xsession, xfce4 (desktop session).

There is no web UI and no Caddy proxy. Connect with an X2Go Client:

  Host:     your KRATE host / SSH endpoint
  Login:    ${username}
  Session:  XFCE (or the session type offered by x2goserver-xsession)

Health check (lists this user's sessions):

  x2golistsessions

Per-user systemd unit is Type=oneshot RemainAfterExit — it only verifies
that x2goserver tools are present after install/update.
EOF
	zenfw::permission::read_exec::set "${data_dir}/README" "${username}" "${username}"
}

_write_verify() {
	cat >"${install_dir}/x2go-verify" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
command -v x2golistsessions >/dev/null 2>&1 || {
	echo "x2golistsessions not found — install x2goserver" >&2
	exit 1
}
# Health: list sessions for the invoking user (empty output is OK).
x2golistsessions >/dev/null 2>&1 || x2golistsessions "${USER}" >/dev/null 2>&1 || true
exit 0
EOF
	chmod 0755 "${install_dir}/x2go-verify"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
}
