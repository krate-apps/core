#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/threadfin/threadfin
# @project KRATE
# @description Threadfin — GitHub release binary (IPTV/EPG) + Caddy proxy; optional ffmpeg.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port
	mkdir -p "${data_dir}" /tmp/threadfin
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	mkdir -p "$(dirname "${env_file}")"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir bin asset_pat
	tmpdir="$(mktemp -d)"
	asset_pat="$(app::cfg install.release.asset)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "${asset_pat}"
	mkdir -p "${install_dir}"
	# Prefer exact Threadfin_linux_amd64 (not *_glibc_*_compat).
	if [[ -f "${tmpdir}/Threadfin_linux_amd64" ]]; then
		bin="${tmpdir}/Threadfin_linux_amd64"
	elif [[ -f "${tmpdir}/Threadfin" ]]; then
		bin="${tmpdir}/Threadfin"
	else
		bin="$(find "${tmpdir}" -type f \( -name 'Threadfin_linux_amd64' -o -name 'Threadfin' \) ! -name '*glibc*' -print -quit 2>/dev/null || true)"
		[[ -n "${bin}" ]] || bin="$(find "${tmpdir}" -type f -name 'Threadfin*' ! -name '*.exe' -print -quit 2>/dev/null || true)"
	fi
	[[ -n "${bin}" && -f "${bin}" ]] || {
		printf '[%s] Threadfin binary missing after release download\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mv "${bin}" "${install_dir}/Threadfin"
	chmod 0755 "${install_dir}/Threadfin"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}
