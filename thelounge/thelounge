#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/thelounge/thelounge
# @project KRATE
# @description The Lounge — npm package in install_dir; start --home data_dir on loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_thelounge_provision
	zenfw::service::generate "${app_name}" true false
	_config
	_secure
}

_config() {
	local default_port config_js
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	config_js="${data_dir}/config.js"
	if [[ ! -f "${config_js}" ]]; then
		cat >"${config_js}" <<EOF
"use strict";
module.exports = {
  public: false,
  host: "127.0.0.1",
  port: ${default_port},
  reverseProxy: true,
  theme: "default",
  prefetch: false,
};
EOF
	fi
	_thelounge_patch_config "${config_js}" "${default_port}"
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "THELOUNGE_HOME" "${data_dir}"
	zenfw::fs::env::set "${env_file}" "NODE_ENV" "production"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::generate "${app_name}" false false
	zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_thelounge_provision
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_secure() {
	local bin users_dir
	bin="${install_dir}/node_modules/.bin/thelounge"
	users_dir="${data_dir}/users"
	mkdir -p "${users_dir}"
	if [[ -f "${users_dir}/${username}.json" ]]; then
		return 0
	fi
	# Prefer non-interactive add; fall back to stdin password prompt.
	if ! zenfw::workspace::user::run "${username}" "${install_dir}" \
		"THELOUNGE_HOME='${data_dir}' '${bin}' add '${username}' --password '${user_password}'" 2>/dev/null; then
		zenfw::workspace::user::run "${username}" "${install_dir}" \
			"printf '%s\\n%s\\n' '${user_password}' '${user_password}' | THELOUNGE_HOME='${data_dir}' '${bin}' add '${username}'" || {
			printf '[%s] thelounge add user failed — create the account via CLI\n' "${app_name}" >&2
			return 0
		}
	fi
	zenfw::vault::save "${username}.${app_name}" "${user_password}" application
}

_thelounge_provision() {
	local build_env
	mkdir -p "${install_dir}"
	cat >"${install_dir}/package.json" <<'EOF'
{
  "name": "krate-thelounge",
  "private": true,
  "description": "KRATE-managed thelounge install"
}
EOF
	cat >"${install_dir}/.npmrc" <<'EOF'
engine-strict=false
fund=false
audit=false
EOF
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	build_env="CI=true HUSKY=0 NODE_ENV=production"
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"${build_env} npm install thelounge@latest" || {
		printf '[%s] npm install thelounge@latest failed\n' "${app_name}" >&2
		return 1
	}
	test -x "${install_dir}/node_modules/.bin/thelounge"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
}

_thelounge_patch_config() {
	local config_js="${1:?}" port="${2:?}"
	[[ -f "${config_js}" ]] || return 0
	python3 - "${config_js}" "${port}" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
port = sys.argv[2]
text = path.read_text(encoding="utf-8")

def set_key(src: str, key: str, value: str) -> str:
    # value already includes quotes / literals as needed
    pat = rf"(?m)^(\s*{re.escape(key)}\s*:\s*)[^,\n]+"
    if re.search(pat, src):
        return re.sub(pat, rf"\g<1>{value}", src, count=1)
    return re.sub(
        r"(?m)^(module\.exports\s*=\s*\{)",
        rf"\1\n  {key}: {value},",
        src,
        count=1,
    )

text = set_key(text, "host", '"127.0.0.1"')
text = set_key(text, "port", port)
text = set_key(text, "reverseProxy", "true")
text = set_key(text, "public", "false")
path.write_text(text, encoding="utf-8")
PY
}
