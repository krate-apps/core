#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/midarr/midarr
# @project KRATE
# @description Midarr — Elixir/Phoenix + Postgres; mix deps/assets/migrate; phx.server on loopback.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_ensure_elixir_stack
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_midarr_provision
	_config
	app::lifecycle::record_effective_branch
}

_config() {
	local default_port db_name secret db_pass
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	db_name="midarr_${username}"
	db_pass="$(zenfw::fs::env::get "${env_file}" "DB_PASSWORD" 2>/dev/null || true)"
	if [[ -z "${db_pass}" ]]; then
		db_pass="$(openssl rand -hex 16)"
	fi
	_ensure_postgres_db "${db_name}" "${db_pass}"

	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "PHX_HOST" "127.0.0.1"
	zenfw::fs::env::set "${env_file}" "MIX_ENV" "prod"
	# Midarr/postgrex expects TCP hostname (not a unix socket path).
	zenfw::fs::env::set "${env_file}" "DB_HOSTNAME" "127.0.0.1"
	zenfw::fs::env::set "${env_file}" "DB_USERNAME" "${username}"
	zenfw::fs::env::set "${env_file}" "DB_PASSWORD" "${db_pass}"
	zenfw::fs::env::set "${env_file}" "DB_DATABASE" "${db_name}"
	# SECRET_KEY_BASE required for MIX_ENV=prod (generate once).
	secret="$(zenfw::fs::env::get "${env_file}" "SECRET_KEY_BASE" 2>/dev/null || true)"
	if [[ -z "${secret}" ]]; then
		secret="$(openssl rand -hex 64)"
		zenfw::fs::env::set "${env_file}" "SECRET_KEY_BASE" "${secret}"
	fi
	# Admin bootstrap (user must change); Midarr requires password length >= 12.
	if [[ -z "$(zenfw::fs::env::get "${env_file}" "SETUP_ADMIN_EMAIL" 2>/dev/null || true)" ]]; then
		zenfw::fs::env::set "${env_file}" "SETUP_ADMIN_EMAIL" "admin@localhost"
		zenfw::fs::env::set "${env_file}" "SETUP_ADMIN_NAME" "admin"
		zenfw::fs::env::set "${env_file}" "SETUP_ADMIN_PASSWORD" "changeme-please"
	fi
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	_write_midarr_run
	_midarr_bind_loopback
	_midarr_migrate
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::generate "${app_name}" false false
	zenfw::service::manage start "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_ensure_elixir_stack
	rm -rf "${install_dir:?}"/* "${install_dir:?}"/.[!.]* 2>/dev/null || true
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_midarr_provision
	_config
	app::lifecycle::record_effective_branch
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_ensure_elixir_stack() {
	zenfw::dependency::apt::install_inline "elixir" || true
	zenfw::dependency::apt::install_inline "erlang-dev" || true
	zenfw::dependency::apt::install_inline "erlang-nox" || true
	zenfw::dependency::apt::install_inline "postgresql" || true
	zenfw::dependency::apt::install_inline "postgresql-contrib" || true
	zenfw::dependency::apt::install_inline "build-essential" || true
	zenfw::dependency::apt::install_inline "nodejs" || true
	zenfw::dependency::apt::install_inline "npm" || true
	command -v mix >/dev/null 2>&1 || {
		printf '[%s] mix (Elixir) missing after apt install — Postgres + Elixir are required\n' "${app_name}" >&2
		return 1
	}
	# Ensure postgres is running (best-effort).
	if command -v systemctl >/dev/null 2>&1; then
		systemctl start postgresql 2>/dev/null || true
		systemctl enable postgresql 2>/dev/null || true
	fi
}

_ensure_postgres_db() {
	local db_name="${1:?}" db_pass="${2:-}"
	# Create role + DB on local apt Postgres (best-effort). Override DB_* if using an external server.
	if ! id -u postgres >/dev/null 2>&1; then
		printf '[%s] postgres system user missing — set DB_* in %s to an existing Postgres\n' \
			"${app_name}" "${env_file}" >&2
		return 0
	fi
	su -s /bin/bash postgres -c "psql -tAc \"SELECT 1 FROM pg_roles WHERE rolname='${username}'\"" 2>/dev/null | grep -q 1 || \
		su -s /bin/bash postgres -c "createuser -s '${username}'" 2>/dev/null || \
		su -s /bin/bash postgres -c "psql -c \"CREATE ROLE \\\"${username}\\\" LOGIN SUPERUSER\"" 2>/dev/null || true
	if [[ -n "${db_pass}" ]]; then
		su -s /bin/bash postgres -c "psql -c \"ALTER ROLE \\\"${username}\\\" WITH PASSWORD '${db_pass}'\"" 2>/dev/null || true
	fi
	su -s /bin/bash postgres -c "psql -tAc \"SELECT 1 FROM pg_database WHERE datname='${db_name}'\"" 2>/dev/null | grep -q 1 || \
		su -s /bin/bash postgres -c "createdb -O '${username}' '${db_name}'" 2>/dev/null || true
}

_midarr_provision() {
	local mix_cmd
	mkdir -p "/home/${username}/.mix" "/home/${username}/.hex"
	zenfw::permission::read_exec::set "/home/${username}/.mix" "${username}" "${username}"
	zenfw::permission::read_exec::set "/home/${username}/.hex" "${username}" "${username}"
	mix_cmd="export MIX_HOME='/home/${username}/.mix' HEX_HOME='/home/${username}/.hex' MIX_ENV=prod;"
	mix_cmd+=" export PATH=\"\$PATH\";"
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"${mix_cmd} mix local.hex --force && mix local.rebar --force" || {
		printf '[%s] mix local.hex/rebar failed\n' "${app_name}" >&2
		return 1
	}
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"${mix_cmd} mix deps.get" || {
		printf '[%s] mix deps.get failed\n' "${app_name}" >&2
		return 1
	}
	# Assets: npm under assets/ then mix assets.deploy (best-effort).
	if [[ -f "${install_dir}/assets/package.json" ]]; then
		zenfw::workspace::user::run "${username}" "${install_dir}/assets" \
			"npm install --no-fund --no-audit" || true
	fi
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"${mix_cmd} mix deps.compile && mix assets.deploy && mix compile" || {
		printf '[%s] mix compile/assets failed (continuing best-effort)\n' "${app_name}" >&2
		zenfw::workspace::user::run "${username}" "${install_dir}" \
			"${mix_cmd} mix compile" || {
			printf '[%s] mix compile failed\n' "${app_name}" >&2
			return 1
		}
	}
	_midarr_bind_loopback
	_write_midarr_run
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
}

_midarr_bind_loopback() {
	# Upstream hardcodes 0.0.0.0; force loopback for KRATE reverse-proxy model.
	local f
	for f in "${install_dir}/config/runtime.exs" "${install_dir}/config/dev.exs" "${install_dir}/config/prod.exs"; do
		[[ -f "${f}" ]] || continue
		sed -i 's/ip: {0, 0, 0, 0, 0, 0, 0, 0}/ip: {127, 0, 0, 1}/g; s/ip: {0, 0, 0, 0}/ip: {127, 0, 0, 1}/g' "${f}" || true
	done
}

_midarr_migrate() {
	local mix_cmd
	mix_cmd="export MIX_HOME='/home/${username}/.mix' HEX_HOME='/home/${username}/.hex' MIX_ENV=prod;"
	mix_cmd+=" set -a; [ -f '${env_file}' ] && . '${env_file}'; set +a;"
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"${mix_cmd} mix ecto.create --quiet || true; mix ecto.migrate" || {
		printf '[%s] ecto.migrate failed — ensure Postgres is up and DB_* are correct\n' "${app_name}" >&2
		return 0
	}
}

_write_midarr_run() {
	cat >"${install_dir}/midarr-run" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "${ROOT}"
export MIX_ENV="${MIX_ENV:-prod}"
export MIX_HOME="${MIX_HOME:-$HOME/.mix}"
export HEX_HOME="${HEX_HOME:-$HOME/.hex}"
exec mix phx.server
EOF
	chmod 0755 "${install_dir}/midarr-run"
}
