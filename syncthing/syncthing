#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/syncthing/syncthing
# @project KRATE
# @description Syncthing — linux-amd64 tarball; serve with GUI on loopback + Caddy proxy (v2 CLI).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	# Prefer STGUIADDRESS; systemd also passes --gui-address for clarity.
	zenfw::fs::env::set "${env_file}" "STGUIADDRESS" "127.0.0.1:${default_port}"
	zenfw::fs::env::set "${env_file}" "STNOBROWSER" "1"
	zenfw::fs::env::set "${env_file}" "STHOMEDIR" "${data_dir}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir bin
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	if [[ -f "${tmpdir}/syncthing" ]]; then
		bin="${tmpdir}/syncthing"
	else
		bin="$(find "${tmpdir}" -type f -name syncthing -print -quit 2>/dev/null || true)"
	fi
	[[ -n "${bin}" && -f "${bin}" ]] || {
		printf '[%s] syncthing binary missing after release extract\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mv "${bin}" "${install_dir}/syncthing"
	chmod 0755 "${install_dir}/syncthing"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}
