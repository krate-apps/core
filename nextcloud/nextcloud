#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/nextcloud/nextcloud
# @project KRATE
# @description Nextcloud — official latest.zip; PHP built-in server on loopback + Caddy; SQLite via occ.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::dependency::apt::install_inline \
		"php-fpm" "php-cli" "php-sqlite3" "php-curl" "php-gd" "php-xml" "php-mbstring" \
		"php-zip" "php-intl" "php-bcmath" "unzip" || true
	command -v php >/dev/null 2>&1 || {
		printf '[%s] php binary missing after apt install\n' "${app_name}" >&2
		return 1
	}
	_fetch_release
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port nc_data
	mkdir -p "${data_dir}/data" "${data_dir}/config" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	nc_data="${data_dir}/data"
	# Persist config under data_dir; Nextcloud expects install_dir/config.
	if [[ -d "${install_dir}/config" && ! -L "${install_dir}/config" ]]; then
		if [[ ! -f "${data_dir}/config/config.php" ]]; then
			cp -a "${install_dir}/config/." "${data_dir}/config/" 2>/dev/null || true
		fi
		rm -rf "${install_dir}/config"
	fi
	ln -sfn "${data_dir}/config" "${install_dir}/config"
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "NEXTCLOUD_DATA" "${nc_data}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	_occ_install_if_needed "${nc_data}"
	zenfw::vault::save "${username}.${app_name}" "${user_password}" application
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	zenfw::dependency::apt::install_inline \
		"php-fpm" "php-cli" "php-sqlite3" "php-curl" "php-gd" "php-xml" "php-mbstring" \
		"php-zip" "php-intl" "php-bcmath" "unzip" || true
	_fetch_release
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_release() {
	local tmpdir zip_url extract_root
	zip_url="https://download.nextcloud.com/server/releases/latest.zip"
	tmpdir="$(mktemp -d)"
	curl -fsSL -L -o "${tmpdir}/nextcloud.zip" "${zip_url}" || {
		printf '[%s] failed to download %s\n' "${app_name}" "${zip_url}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	unzip -qo "${tmpdir}/nextcloud.zip" -d "${tmpdir}/extract" || {
		printf '[%s] unzip of Nextcloud release failed\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	if [[ -d "${tmpdir}/extract/nextcloud" ]]; then
		extract_root="${tmpdir}/extract/nextcloud"
	else
		extract_root="$(find "${tmpdir}/extract" -mindepth 1 -maxdepth 1 -type d -print -quit 2>/dev/null || true)"
	fi
	[[ -n "${extract_root}" && -f "${extract_root}/occ" ]] || {
		printf '[%s] Nextcloud tree (occ) missing after extract\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mkdir -p "${install_dir}"
	# Preserve live config symlink / directory under install_dir.
	find "${install_dir}" -mindepth 1 -maxdepth 1 ! -name config -exec rm -rf {} + 2>/dev/null || true
	(
		cd "${extract_root}"
		find . -mindepth 1 -maxdepth 1 ! -name config -exec cp -a {} "${install_dir}/" \;
	)
	# Seed packaged config once if data_dir has none.
	if [[ -d "${extract_root}/config" ]]; then
		mkdir -p "${data_dir}/config"
		if [[ ! -f "${data_dir}/config/config.php" && ! -f "${data_dir}/config/CAN_INSTALL" ]]; then
			cp -a "${extract_root}/config/." "${data_dir}/config/" 2>/dev/null || true
		fi
	fi
	chmod 0755 "${install_dir}/occ" 2>/dev/null || true
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}

_occ_install_if_needed() {
	local nc_data="${1:?}"
	local config_php="${data_dir}/config/config.php"
	[[ -f "${config_php}" ]] && return 0
	[[ -f "${install_dir}/occ" ]] || {
		printf '[%s] occ missing; cannot run maintenance:install\n' "${app_name}" >&2
		return 1
	}
	mkdir -p "${nc_data}"
	# Non-interactive SQLite install as the KRATE user (per-user instance; not www-data).
	su -s /bin/bash -c \
		"cd '${install_dir}' && php occ maintenance:install \
			--database=sqlite \
			--admin-user='${username}' \
			--admin-pass='${user_password}' \
			--data-dir='${nc_data}' \
			--no-interaction" \
		- "${username}" || {
		printf '[%s] php occ maintenance:install failed\n' "${app_name}" >&2
		return 1
	}
}
