#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/autoscan/autoscan
# @project KRATE
# @description Autoscan — Cloudbox linux_amd64 release; webhook API on loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
	_secure
}

_config() {
	local default_port config_file
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	config_file="${data_dir}/config.yml"
	if [[ ! -f "${config_file}" ]]; then
		_autoscan_write_initial_config "${config_file}" "${default_port}"
	else
		_autoscan_patch_config "${config_file}" "${default_port}"
	fi
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::private::set "${config_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	# Webhook API + /triggers/manual form — proxy yes.
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_secure() {
	zenfw::vault::save "${username}.${app_name}" "${user_password}" application
}

_fetch_binary() {
	local tmpdir bin
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	if [[ -f "${tmpdir}/autoscan" ]]; then
		bin="${tmpdir}/autoscan"
	else
		bin="$(find "${tmpdir}" -type f \( -name 'autoscan' -o -name '*linux_amd64*' \) ! -name '*.txt' -print -quit 2>/dev/null || true)"
	fi
	[[ -n "${bin}" && -f "${bin}" ]] || {
		printf '[%s] autoscan binary missing after release download\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mv "${bin}" "${install_dir}/autoscan"
	chmod 0755 "${install_dir}/autoscan"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}

_autoscan_write_initial_config() {
	local config_file="${1:?}" port="${2:?}"
	python3 - "${config_file}" "${port}" "${username}" "${user_password}" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
port, user, password = sys.argv[2], sys.argv[3], sys.argv[4]

def q(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'

path.write_text(
    f"""# Autoscan — edit triggers/targets, then restart.
# Docs: https://github.com/Cloudbox/autoscan
authentication:
  username: {q(user)}
  password: {q(password)}

host:
  - 127.0.0.1
port: {port}

minimum-age: 10m
scan-delay: 5s
scan-stats: 1h

triggers:
  manual:
    priority: 5

  sonarr:
    - name: sonarr
      priority: 1

  radarr:
    - name: radarr
      priority: 1

  lidarr:
    - name: lidarr
      priority: 1

  readarr:
    - name: readarr
      priority: 1

targets:
  plex: []
  emby: []
  jellyfin: []
""",
    encoding="utf-8",
)
PY
}

_autoscan_patch_config() {
	local config_file="${1:?}" port="${2:?}"
	python3 - "${config_file}" "${port}" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
port = sys.argv[2]
text = path.read_text(encoding="utf-8")
if re.search(r"(?m)^port:\s*", text):
    text = re.sub(r"(?m)^port:\s*.*$", f"port: {port}", text, count=1)
else:
    text = f"port: {port}\n" + text
if not re.search(r"(?m)^host:\s*$", text) and "127.0.0.1" not in text:
    text = re.sub(r"(?m)^port:", "host:\n  - 127.0.0.1\nport:", text, count=1)
path.write_text(text, encoding="utf-8")
PY
}
