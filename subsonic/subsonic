#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/subsonic/subsonic
# @project KRATE
# @description Subsonic 6.1.6 standalone — S3 tarball (curl only); Java 8→17; loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_SUBSONIC_URL="https://s3-eu-west-1.amazonaws.com/subsonic-public/download/subsonic-6.1.6-standalone.tar.gz"

_add() {
	_ensure_java
	_fetch_standalone
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port music_folder
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	music_folder="/home/${username}/media/music"
	mkdir -p "${music_folder}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${music_folder}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	_patch_subsonic_sh "${default_port}" "${music_folder}"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::fs::env::set "${env_file}" "SUBSONIC_PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "SUBSONIC_HOME" "${data_dir}"
	zenfw::fs::env::set "${env_file}" "SUBSONIC_HOST" "127.0.0.1"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_ensure_java
	_fetch_standalone
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

# Prefer Java 8 (upstream target); fall back to 17 when 8 is unavailable.
_ensure_java() {
	if zenfw::dependency::apt::install_inline "openjdk-8-jre-headless" 2>/dev/null; then
		return 0
	fi
	zenfw::dependency::apt::install_inline "openjdk-17-jre-headless" || {
		printf '[%s] neither openjdk-8-jre-headless nor openjdk-17-jre-headless available\n' "${app_name}" >&2
		return 1
	}
}

_fetch_standalone() {
	local tmpdir
	tmpdir="$(mktemp -d)"
	mkdir -p "${install_dir}"
	curl -fsSL -L -o "${tmpdir}/subsonic-standalone.tar.gz" "${_SUBSONIC_URL}"
	tar -xzf "${tmpdir}/subsonic-standalone.tar.gz" -C "${tmpdir}"
	# Flat layout: subsonic.sh + war + booter jar at archive root.
	[[ -f "${tmpdir}/subsonic.sh" ]] || {
		printf '[%s] subsonic.sh missing after extract\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	rm -rf "${install_dir:?}"/*
	for f in subsonic.sh subsonic.war subsonic-booter-jar-with-dependencies.jar README.TXT "Getting Started.html" subsonic.bat; do
		[[ -e "${tmpdir}/${f}" ]] || continue
		mv "${tmpdir}/${f}" "${install_dir}/"
	done
	[[ -f "${install_dir}/subsonic.sh" && -f "${install_dir}/subsonic-booter-jar-with-dependencies.jar" ]] || {
		printf '[%s] required Subsonic runtime files missing after extract\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	chmod 0755 "${install_dir}/subsonic.sh"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}

# Patch defaults for multi-user home/host/port and run in foreground under systemd.
_patch_subsonic_sh() {
	local port="${1:?}" music_folder="${2:?}" script="${install_dir}/subsonic.sh"
	[[ -f "${script}" ]] || {
		printf '[%s] subsonic.sh not found at %s\n' "${app_name}" "${script}" >&2
		return 1
	}
	# Defaults (env vars still override; systemd also passes --home/--host/--port).
	sed -i \
		-e "s|^SUBSONIC_HOME=\${SUBSONIC_HOME:-/var/subsonic}|SUBSONIC_HOME=\${SUBSONIC_HOME:-${data_dir}}|" \
		-e "s|^SUBSONIC_HOST=\${SUBSONIC_HOST:-0.0.0.0}|SUBSONIC_HOST=\${SUBSONIC_HOST:-127.0.0.1}|" \
		-e "s|^SUBSONIC_PORT=\${SUBSONIC_PORT:-4040}|SUBSONIC_PORT=\${SUBSONIC_PORT:-${port}}|" \
		-e "s|^SUBSONIC_DEFAULT_MUSIC_FOLDER=\${SUBSONIC_DEFAULT_MUSIC_FOLDER:-/var/music}|SUBSONIC_DEFAULT_MUSIC_FOLDER=\${SUBSONIC_DEFAULT_MUSIC_FOLDER:-${music_folder}}|" \
		"${script}"
	# Upstream backgrounds with &; make Type=simple friendly via exec foreground.
	if grep -q 'subsonic-booter-jar-with-dependencies.jar > \${LOG} 2>&1 &' "${script}"; then
		sed -i \
			-e '/^rm -f \${LOG}$/d' \
			-e '/^LOG=\${SUBSONIC_HOME}\/subsonic_sh.log$/d' \
			-e 's|  -jar subsonic-booter-jar-with-dependencies.jar > ${LOG} 2>&1 &|  -jar subsonic-booter-jar-with-dependencies.jar|' \
			"${script}"
		# Drop PID/echo block after java (no longer a background child).
		# Replace trailing PIDFILE/quiet section with a no-op comment if present.
		if grep -q 'Write pid to pidfile' "${script}"; then
			python3 - "${script}" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
needle = "\n# Write pid to pidfile if it is defined.\n"
idx = text.find(needle)
if idx != -1:
    # Keep java invocation; drop everything after it that assumes backgrounding.
    head = text[:idx]
    # Ensure java line uses exec so systemd tracks the JVM.
    head = head.replace(
        "${JAVA} -Xmx${SUBSONIC_MAX_MEMORY}m \\",
        "exec ${JAVA} -Xmx${SUBSONIC_MAX_MEMORY}m \\",
        1,
    )
    path.write_text(head + "\n", encoding="utf-8")
PY
		else
			sed -i 's|^\${JAVA} -Xmx|exec ${JAVA} -Xmx|' "${script}"
		fi
	fi
	chmod 0755 "${script}"
}
