#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/kavita/kavita
# @project KRATE
# @description Kavita — linux-x64 tarball; config/ persisted under data_dir (never wiped on update).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_package
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port base settings_file
	mkdir -p "${data_dir}/config"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	base="${url_base:-/}"
	[[ -n "${base}" ]] || base="/"
	# Persist config beside data_dir; binary expects ./config relative to WorkingDirectory.
	if [[ -d "${install_dir}/config" && ! -L "${install_dir}/config" ]]; then
		# First install: seed data_dir from packaged config if empty.
		if [[ ! -f "${data_dir}/config/appsettings.json" && ! -f "${data_dir}/config/appsettings-init.json" ]]; then
			cp -a "${install_dir}/config/." "${data_dir}/config/" 2>/dev/null || true
		fi
		rm -rf "${install_dir}/config"
	fi
	ln -sfn "${data_dir}/config" "${install_dir}/config"
	settings_file="${data_dir}/config/appsettings.json"
	if [[ ! -f "${settings_file}" && -f "${data_dir}/config/appsettings-init.json" ]]; then
		cp "${data_dir}/config/appsettings-init.json" "${settings_file}"
	fi
	if [[ ! -f "${settings_file}" ]]; then
		cat >"${settings_file}" <<EOF
{
  "TokenKey": "$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')",
  "Port": ${default_port},
  "IpAddresses": "127.0.0.1",
  "BaseUrl": "${base}",
  "Cache": 75
}
EOF
	fi
	_kavita_patch_appsettings "${settings_file}" "${default_port}" "${base}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_package
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

# Replace package binaries only — never wipe data_dir or install_dir/config (symlink).
_fetch_package() {
	local tmpdir src
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	src="${tmpdir}"
	if [[ -f "${tmpdir}/Kavita/Kavita" ]]; then
		src="${tmpdir}/Kavita"
	elif [[ -f "${tmpdir}/Kavita" && -d "${tmpdir}/config" ]]; then
		src="${tmpdir}"
	else
		src="$(find "${tmpdir}" -type f -name Kavita -printf '%h\n' -quit 2>/dev/null || true)"
		[[ -n "${src}" ]] || {
			printf '[%s] Kavita binary missing after extract\n' "${app_name}" >&2
			rm -rf "${tmpdir}"
			return 1
		}
	fi
	mkdir -p "${install_dir}"
	# Preserve config symlink / directory under install_dir.
	find "${install_dir}" -mindepth 1 -maxdepth 1 ! -name config -exec rm -rf {} + 2>/dev/null || true
	# Copy package tree excluding config (live config lives under data_dir).
	(
		cd "${src}"
		find . -mindepth 1 -maxdepth 1 ! -name config -exec cp -a {} "${install_dir}/" \;
	)
	# If packaged config exists and data_dir has none yet, seed once.
	if [[ -d "${src}/config" ]]; then
		mkdir -p "${data_dir}/config"
		if [[ ! -f "${data_dir}/config/appsettings.json" && ! -f "${data_dir}/config/appsettings-init.json" ]]; then
			cp -a "${src}/config/." "${data_dir}/config/"
		fi
	fi
	chmod 0755 "${install_dir}/Kavita"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}

_kavita_patch_appsettings() {
	local settings_file="${1:?}" port="${2:?}" base="${3:?}"
	python3 - "${settings_file}" "${port}" "${base}" <<'PY'
import json
import os
import sys

path, port, base = sys.argv[1], int(sys.argv[2]), sys.argv[3]
data = {}
if os.path.isfile(path):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f) or {}
    except (OSError, json.JSONDecodeError):
        data = {}
data["Port"] = port
data["IpAddresses"] = "127.0.0.1"
data["BaseUrl"] = base if base else "/"
if not data.get("TokenKey"):
    import secrets
    data["TokenKey"] = secrets.token_urlsafe(48)
data.setdefault("Cache", 75)
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY
}
