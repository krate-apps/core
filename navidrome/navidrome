#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/navidrome/navidrome
# @project KRATE
# @description Navidrome — linux_amd64 tarball; ND_* env (loopback + Caddy proxy).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port music_folder base
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	music_folder="/home/${username}/media/music"
	mkdir -p "${music_folder}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${music_folder}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	base="${url_base:-/}"
	[[ -n "${base}" ]] || base="/"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::fs::env::set "${env_file}" "ND_ADDRESS" "127.0.0.1"
	zenfw::fs::env::set "${env_file}" "ND_PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "ND_MUSICFOLDER" "${music_folder}"
	zenfw::fs::env::set "${env_file}" "ND_DATAFOLDER" "${data_dir}"
	zenfw::fs::env::set "${env_file}" "ND_BASEURL" "${base}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir bin
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	if [[ -f "${tmpdir}/navidrome" ]]; then
		bin="${tmpdir}/navidrome"
	else
		bin="$(find "${tmpdir}" -type f -name navidrome -print -quit 2>/dev/null || true)"
	fi
	[[ -n "${bin}" && -f "${bin}" ]] || {
		printf '[%s] navidrome binary missing after release extract\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mv "${bin}" "${install_dir}/navidrome"
	chmod 0755 "${install_dir}/navidrome"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}
