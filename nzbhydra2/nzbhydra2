#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/nzbhydra2/nzbhydra2
# @project KRATE
# @description NZBHydra2 — GitHub release zip (Python wrapper + native core) + web UI proxy
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_release
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port
	mkdir -p "${data_dir}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port}"
	zenfw::fs::env::set "${env_file}" "NZBHYDRA2_PORT" "${default_port}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_release
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

_fetch_release() {
	local tmpdir wrapper root
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	if [[ -f "${tmpdir}/nzbhydra2wrapperPy3.py" ]]; then
		root="${tmpdir}"
	else
		wrapper="$(find "${tmpdir}" -type f -name nzbhydra2wrapperPy3.py -print -quit || true)"
		[[ -n "${wrapper}" ]] || {
			printf '[%s] nzbhydra2wrapperPy3.py not found in release asset\n' "${app_name}" >&2
			rm -rf "${tmpdir}"
			return 1
		}
		root="$(dirname "${wrapper}")"
	fi
	# Keep wrapper + native core (and companion files) in install_dir; data stays in data_dir.
	rm -rf "${install_dir:?}"/*
	shopt -s dotglob nullglob
	mv "${root}"/* "${install_dir}/"
	shopt -u dotglob nullglob
	chmod 0755 "${install_dir}/nzbhydra2wrapperPy3.py" 2>/dev/null || true
	[[ -f "${install_dir}/core" ]] && chmod 0755 "${install_dir}/core"
	rm -rf "${tmpdir}"
}
