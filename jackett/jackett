#!/usr/bin/env bash
# @file applications/apps-community/jackett/jackett
# @project KRATE
# @description Jackett — app handler (aligned with community radarr; .NET binary, ServerConfig.json + cookie-based admin password)
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::git::release::get "${install_dir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	zenfw::service::generate "${app_name}" true true
	_config
	_secure
}

_config() {
	local apikey default_port config_file current_json merged_json
	mkdir -p "${data_dir}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	apikey="${service_apikey}"
	default_port="${service_default_port}"
	config_file="${data_dir}/ServerConfig.json"
	sleep 5
	[[ -f "${config_file}" ]] || {
		printf '[jackett] missing config file after startup: %s\n' "${config_file}" >&2
		return 1
	}
	current_json="$(<"${config_file}")"
	merged_json="$(zenfw::json::merge "${current_json}" \
		"Port" "${default_port}" \
		"APIKey" "${apikey}" \
		"BasePathOverride" "${url_base}")"
	zenfw::json::validate "${merged_json}" >/dev/null
	printf '%s\n' "${merged_json}" > "${config_file}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	zenfw::git::release::get "${install_dir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

_secure() {
	local url cookie listen_port
	listen_port="$(printf '%s\n' "${service_default_port:-}" | tr -cd '0-9')"
	url="http://127.0.0.1:${listen_port}${url_base}"
	cookie="$(mktemp)"
	zenfw::request::wait::ping "${url}/UI/Dashboard" 60 1000 false || return 1
	curl -fsSL \
		-c "$cookie" -b "$cookie" \
		"${url}/UI/Dashboard/" \
		>/dev/null || return 1
	curl -fsSL \
	-c "$cookie" -b "$cookie" \
	-H 'Content-Type: application/json' \
	-H 'X-Requested-With: XMLHttpRequest' \
	--data-binary "\"${user_password}\"" \
	"${url}/api/v2.0/server/adminpassword"
}
