#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/kometa/kometa
# @project KRATE
# @description Kometa — git clone + uv/venv; CLI metadata runner (no proxy / no UI).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::workspace::uv::install
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_kometa_provision_runtime
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local config_file template_file
	mkdir -p "${data_dir}/config" "$(dirname "${env_file}")"
	config_file="${data_dir}/config/config.yml"
	template_file="${install_dir}/config/config.yml.template"
	if [[ ! -f "${config_file}" ]]; then
		if [[ -f "${template_file}" ]]; then
			cp "${template_file}" "${config_file}"
		else
			cat >"${config_file}" <<'EOF'
# Kometa — edit libraries / plex / tmdb before enabling the service.
# Docs: https://kometa.wiki/
libraries: {}
EOF
		fi
	fi
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::fs::env::set "${env_file}" "KOMETA_CONFIG" "${config_file}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
	# No web UI / no Caddy. Start after config exists (user must fill Plex/etc.).
	zenfw::service::manage start "${service_unit}" 2>/dev/null || \
		zenfw::service::manage restart "${service_unit}" 2>/dev/null || true
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	rm -rf "${install_dir:?}"/* "${install_dir:?}"/.[!.]* 2>/dev/null || true
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_kometa_provision_runtime
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_kometa_provision_runtime() {
	# Prefer requirements.txt (includes serializd-py git dep) like decluttarr; uv sync if only pyproject.
	printf '3.12\n' >"${install_dir}/.python-version"
	zenfw::workspace::user::run "${username}" "${install_dir}" "uv python install 3.12" || {
		printf '[%s] uv python install 3.12 failed\n' "${app_name}" >&2
		return 1
	}
	if [[ -f "${install_dir}/requirements.txt" ]]; then
		zenfw::workspace::venv::create "${install_dir}" "${username}" false
		zenfw::workspace::user::run "${username}" "${install_dir}" \
			"UV_PYTHON=3.12 uv pip install -r requirements.txt" || {
			printf '[%s] uv pip install -r requirements.txt failed\n' "${app_name}" >&2
			return 1
		}
	elif [[ -f "${install_dir}/uv.lock" ]]; then
		zenfw::workspace::user::run "${username}" "${install_dir}" "UV_PYTHON=3.12 uv sync --frozen" || \
			zenfw::workspace::user::run "${username}" "${install_dir}" "UV_PYTHON=3.12 uv sync" || {
			printf '[%s] uv sync failed in %s\n' "${app_name}" "${install_dir}" >&2
			return 1
		}
	elif [[ -f "${install_dir}/pyproject.toml" ]]; then
		zenfw::workspace::user::run "${username}" "${install_dir}" "UV_PYTHON=3.12 uv sync" || {
			printf '[%s] uv sync failed in %s\n' "${app_name}" "${install_dir}" >&2
			return 1
		}
	else
		printf '[%s] no requirements.txt / pyproject.toml in %s\n' "${app_name}" "${install_dir}" >&2
		return 1
	fi
	test -f "${install_dir}/kometa.py"
	test -x "${install_dir}/.venv/bin/python"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
}
