#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/znc/znc
# @project KRATE
# @description ZNC — apt package; per-user datadir + webadmin listener on loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::dependency::apt::install_inline "znc" || true
	command -v znc >/dev/null 2>&1 || {
		printf '[%s] znc binary missing after apt install\n' "${app_name}" >&2
		return 1
	}
	mkdir -p "${install_dir}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::service::generate "${app_name}" true false
	_config
	_secure
}

_config() {
	local default_port conf_dir conf_file uri_prefix
	mkdir -p "${data_dir}/configs" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	conf_dir="${data_dir}/configs"
	conf_file="${conf_dir}/znc.conf"
	uri_prefix="${url_base}"
	[[ "${uri_prefix}" == */ ]] || uri_prefix="${uri_prefix}/"
	[[ "${uri_prefix}" == /* ]] || uri_prefix="/${uri_prefix}"
	[[ "${uri_prefix}" == "/" ]] && uri_prefix="/"
	if [[ ! -f "${conf_file}" ]]; then
		_znc_write_initial_conf "${conf_file}" "${default_port}" "${uri_prefix}"
	else
		_znc_patch_listener "${conf_file}" "${default_port}" "${uri_prefix}"
	fi
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::private::set "${conf_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	zenfw::dependency::apt::install_inline "znc" || true
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_secure() {
	zenfw::vault::save "${username}.${app_name}" "${user_password}" application
}

_znc_write_initial_conf() {
	local conf_file="${1:?}" port="${2:?}" uri_prefix="${3:?}"
	local salt pass_line
	salt="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 20)"
	pass_line="$(
		python3 - "${user_password}" "${salt}" <<'PY'
import hashlib
import sys

password, salt = sys.argv[1], sys.argv[2]
digest = hashlib.sha256((password + salt).encode("utf-8")).hexdigest()
print(f"sha256#{digest}#{salt}#")
PY
	)"
	cat >"${conf_file}" <<EOF
Version = 1.9
<Listener l>
	Host = 127.0.0.1
	Port = ${port}
	IPv4 = true
	IPv6 = false
	SSL = false
	AllowIRC = true
	AllowWeb = true
	URIPrefix = ${uri_prefix}
</Listener>
LoadModule = webadmin
<User ${username}>
	Pass       = ${pass_line}
	Admin      = true
	Nick       = ${username}
	AltNick    = ${username}_
	Ident      = ${username}
	RealName   = ${username}
	QuitMsg    = ZNC - https://znc.in
	LoadModule = webadmin
</User>
EOF
}

_znc_patch_listener() {
	local conf_file="${1:?}" port="${2:?}" uri_prefix="${3:?}"
	python3 - "${conf_file}" "${port}" "${uri_prefix}" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
port, uri = sys.argv[2], sys.argv[3]
text = path.read_text(encoding="utf-8")

def set_in_listener(src: str, key: str, value: str) -> str:
    pat = rf"(?ms)(<Listener\b[^>]*>.*?)(^\s*{re.escape(key)}\s*=\s*)[^\n]+"
    if re.search(pat, src):
        return re.sub(pat, rf"\1\2{value}", src, count=1)
    return re.sub(
        r"(?ms)(<Listener\b[^>]*>)",
        rf"\1\n\t{key} = {value}",
        src,
        count=1,
    )

text = set_in_listener(text, "Host", "127.0.0.1")
text = set_in_listener(text, "Port", port)
text = set_in_listener(text, "AllowWeb", "true")
text = set_in_listener(text, "URIPrefix", uri)
if "LoadModule = webadmin" not in text:
    text = "LoadModule = webadmin\n" + text
path.write_text(text, encoding="utf-8")
PY
}
