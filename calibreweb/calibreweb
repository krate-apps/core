#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/calibreweb/calibreweb
# @project KRATE
# @description Calibre-Web — uv venv + pip install calibreweb (cps); loopback + Caddy proxy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::workspace::uv::install
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_calibreweb_provision_runtime
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port settings_db
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	settings_db="${data_dir}/app.db"
	zenfw::fs::env::set "${env_file}" "CALIBRE_PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "CALIBRE_DBPATH" "${data_dir}"
	_calibreweb_patch_port "${settings_db}" "${default_port}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_calibreweb_provision_runtime
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_calibreweb_provision_runtime() {
	printf '3.12\n' >"${install_dir}/.python-version"
	zenfw::workspace::user::run "${username}" "${install_dir}" "uv python install 3.12" || {
		printf '[%s] uv python install 3.12 failed\n' "${app_name}" >&2
		return 1
	}
	zenfw::workspace::venv::create "${install_dir}" "${username}" false
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"UV_PYTHON=3.12 uv pip install --upgrade calibreweb" || {
		printf '[%s] uv pip install calibreweb failed\n' "${app_name}" >&2
		return 1
	}
	test -x "${install_dir}/.venv/bin/cps"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
}

# Keep app.db listen port in sync with KRATE autogen (CALIBRE_PORT only seeds new DBs).
_calibreweb_patch_port() {
	local settings_db="${1:?}" port="${2:?}"
	[[ -f "${settings_db}" ]] || return 0
	python3 - "${settings_db}" "${port}" <<'PY'
import sqlite3
import sys

path, port = sys.argv[1], int(sys.argv[2])
try:
    con = sqlite3.connect(path)
except sqlite3.Error:
    sys.exit(0)
try:
    cur = con.cursor()
    tables = {r[0] for r in cur.execute("SELECT name FROM sqlite_master WHERE type='table'")}
    for table in ("settings", "setting"):
        if table not in tables:
            continue
        cols = {r[1] for r in cur.execute(f"PRAGMA table_info({table})")}
        if "config_port" in cols:
            cur.execute(f"UPDATE {table} SET config_port = ?", (port,))
        if "config_external_port" in cols:
            cur.execute(f"UPDATE {table} SET config_external_port = ?", (port,))
    con.commit()
finally:
    con.close()
PY
}
