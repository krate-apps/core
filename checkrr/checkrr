#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/checkrr/checkrr
# @project KRATE
# @description Checkrr — GitHub release binary + web UI proxy
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port config_file
	mkdir -p "${data_dir}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port}"
	config_file="${data_dir}/checkrr.yaml"
	if [[ ! -f "${config_file}" ]]; then
		zenfw::request::wait::ping "https://raw.githubusercontent.com/aetaric/checkrr/main/checkrr.yaml.minimal" 30 1000 false
		curl -fsSL "https://raw.githubusercontent.com/aetaric/checkrr/main/checkrr.yaml.minimal" -o "${config_file}"
	fi
	touch "${data_dir}/checkrr.db"
	if ! grep -qE '^[[:space:]]*webserver:' "${config_file}"; then
		cat >>"${config_file}" <<EOF

webserver:
  port: ${default_port}
  tls: false
  baseurl: "${url_base%/}/"
  trustedproxies:
    - 127.0.0.1
EOF
	else
		sed -i \
			-e "s|^[[:space:]]*port:[[:space:]]*[0-9]\\+|  port: ${default_port}|" \
			-e "s|^[[:space:]]*baseurl:.*|  baseurl: \"${url_base%/}/\"|" \
			"${config_file}"
	fi
	if grep -qE '^[[:space:]]*database:' "${config_file}"; then
		sed -i "s|^[[:space:]]*database:.*|  database: ${data_dir}/checkrr.db|" "${config_file}"
	fi
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir bin
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	if [[ -f "${tmpdir}/checkrr" ]]; then
		mv "${tmpdir}/checkrr" "${install_dir}/checkrr"
	else
		bin="$(find "${tmpdir}" -type f -name checkrr -print -quit || true)"
		[[ -n "${bin}" ]] && mv "${bin}" "${install_dir}/checkrr"
	fi
	chmod 0755 "${install_dir}/checkrr"
	rm -rf "${tmpdir}"
}
