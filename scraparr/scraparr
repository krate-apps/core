#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/scraparr/scraparr
# @project KRATE
# @description Scraparr — git clone, uv sync, Prometheus *arr metrics (no proxy / no UI).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::workspace::uv::install
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_scraparr_provision_runtime
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port config_file example_file
	default_port="${service_default_port}"
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	config_file="${data_dir}/config.yaml"
	example_file="${install_dir}/config.yaml"
	if [[ ! -f "${config_file}" && -f "${example_file}" ]]; then
		cp "${example_file}" "${config_file}"
	elif [[ ! -f "${config_file}" ]]; then
		cat >"${config_file}" <<EOF
general:
  address: 127.0.0.1
  port: ${default_port}
EOF
	fi
	# Symlink for local discovery; systemd BindPaths maps data_dir → /scraparr/config.
	rm -rf "${install_dir}/config"
	mkdir -p "${install_dir}/config"
	ln -sfn "${config_file}" "${install_dir}/config/config.yaml"
	_scraparr_patch_config "${config_file}" "${default_port}"
	_scraparr_wire_servarr "${config_file}"
	zenfw::fs::env::set "${env_file}" "SCRAPARR_CONFIG" "${config_file}"
	zenfw::fs::env::set "${env_file}" "GENERAL_ADDRESS" "127.0.0.1"
	zenfw::fs::env::set "${env_file}" "GENERAL_PORT" "${default_port}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
	if _scraparr_config_has_targets "${config_file}"; then
		zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
	else
		zenfw::service::manage stop "${service_unit}" 2>/dev/null || true
		printf '[%s] no *arr targets configured — edit %s then: systemctl start %s\n' \
			"${app_name}" "${config_file}" "${service_unit}" >&2
	fi
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	rm -rf "${install_dir:?}"/* "${install_dir:?}"/.[!.]* 2>/dev/null || true
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_scraparr_provision_runtime
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_scraparr_provision_runtime() {
	printf '3.12\n' > "${install_dir}/.python-version"
	zenfw::workspace::user::run "${username}" "${install_dir}" "uv python install 3.12" || {
		printf '[%s] uv python install 3.12 failed\n' "${app_name}" >&2
		return 1
	}
	if [[ -f "${install_dir}/uv.lock" ]]; then
		zenfw::workspace::user::run "${username}" "${install_dir}" "UV_PYTHON=3.12 uv sync --frozen" || \
			zenfw::workspace::user::run "${username}" "${install_dir}" "UV_PYTHON=3.12 uv sync" || {
			printf '[%s] uv sync failed in %s\n' "${app_name}" "${install_dir}" >&2
			return 1
		}
	else
		zenfw::workspace::user::run "${username}" "${install_dir}" "UV_PYTHON=3.12 uv sync" || {
			printf '[%s] uv sync failed in %s\n' "${app_name}" "${install_dir}" >&2
			return 1
		}
	fi
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
}

# Bind metrics to loopback and set autogen port. Upstream main reads GENERAL (upper);
# template uses general (lower) — write both so either branch works.
_scraparr_patch_config() {
	local config_file="${1:?}" port="${2:?}"
	[[ -f "${config_file}" ]] || return 0
	python3 - "${config_file}" "${port}" <<'PY'
import sys
try:
    import yaml
except ImportError:
    sys.exit(0)
path, port = sys.argv[1], int(sys.argv[2])
with open(path, encoding="utf-8") as f:
    doc = yaml.safe_load(f) or {}
for key in ("general", "GENERAL"):
    block = doc.get(key)
    if not isinstance(block, dict):
        block = {}
    block["address"] = "127.0.0.1"
    block["port"] = port
    doc[key] = block
# Docker-style hostnames → loopback for local KRATE siblings.
text = yaml.safe_dump(doc, default_flow_style=False, sort_keys=False)
for host, default_port in (
    ("sonarr", 8989),
    ("radarr", 7878),
    ("prowlarr", 9696),
    ("bazarr", 6767),
    ("readarr", 8787),
    ("whisparr", 6969),
    ("jellyfin", 8096),
    ("jellyseerr", 5055),
    ("overseerr", 5055),
    ("seerr", 5055),
):
    text = text.replace(f"http://{host}:{default_port}", f"http://127.0.0.1:{default_port}")
with open(path, "w", encoding="utf-8") as f:
    f.write(text)
PY
	sed -i \
		-e 's|http://sonarr:8989|http://127.0.0.1:8989|g' \
		-e 's|http://radarr:7878|http://127.0.0.1:7878|g' \
		-e 's|http://prowlarr:9696|http://127.0.0.1:9696|g' \
		-e 's|http://bazarr:6767|http://127.0.0.1:6767|g' \
		-e 's|http://readarr:8787|http://127.0.0.1:8787|g' \
		-e 's|http://whisparr:6969|http://127.0.0.1:6969|g' \
		-e 's|http://jellyfin:8096|http://127.0.0.1:8096|g' \
		-e 's|http://jellyseerr:5055|http://127.0.0.1:5055|g' \
		-e 's|http://overseerr:5055|http://127.0.0.1:5055|g' \
		"${config_file}"
}

# Wire API keys / ports from sibling *.env files; drop placeholder-only services.
_scraparr_wire_servarr() {
	local config_file="${1:?}"
	[[ -f "${config_file}" ]] || return 0
	python3 - "${config_file}" "${username}" <<'PY'
import os
import sys

try:
    import yaml
except ImportError:
    sys.exit(0)

path, username = sys.argv[1], sys.argv[2]
env_dir = f"/home/{username}/.krate/applications"

# scraparr service → (krate app id, env prefix for *arr-style keys)
SERVICES = {
    "sonarr": ("sonarr", "SONARR"),
    "radarr": ("radarr", "RADARR"),
    "prowlarr": ("prowlarr", "PROWLARR"),
    "lidarr": ("lidarr", "LIDARR"),
    "readarr": ("readarr", "READARR"),
    "whisparr": ("whisparr", "WHISPARR"),
}


def env_get(env_path, key):
    if not os.path.isfile(env_path):
        return ""
    with open(env_path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            if k == key:
                return v.strip().strip('"').strip("'")
    return ""


with open(path, encoding="utf-8") as f:
    doc = yaml.safe_load(f) or {}

placeholder = {"key", "xxxx", "xxx", "", None}
meta_keys = {"general", "GENERAL", "auth", "AUTH"}
kept = {k: v for k, v in doc.items() if k in meta_keys}

def keep_existing(svc, existing):
    if isinstance(existing, dict):
        if existing.get("api_key") not in placeholder:
            kept[svc] = existing
    elif isinstance(existing, list):
        filtered = [
            e for e in existing
            if isinstance(e, dict) and e.get("api_key") not in placeholder
        ]
        if filtered:
            kept[svc] = filtered

for svc, (app_id, prefix) in SERVICES.items():
    sibling = os.path.join(env_dir, f"{app_id}.env")
    apikey = env_get(sibling, f"{prefix}__AUTH__APIKEY")
    port = env_get(sibling, f"{prefix}__SERVER__PORT")
    urlbase = env_get(sibling, f"{prefix}__SERVER__URLBASE") or ""
    if apikey and port:
        kept[svc] = {
            "url": f"http://127.0.0.1:{port}{urlbase}",
            "api_key": apikey,
            "alias": app_id,
        }
    else:
        keep_existing(svc, doc.get(svc))

# Preserve other connectors (bazarr, jellyfin, …) when not placeholders.
for svc, existing in doc.items():
    if svc in meta_keys or svc in SERVICES or svc in kept:
        continue
    keep_existing(svc, existing)

with open(path, "w", encoding="utf-8") as f:
    yaml.safe_dump(kept, f, default_flow_style=False, sort_keys=False)
PY
}

_scraparr_config_has_targets() {
	local config_file="${1:?}"
	python3 - "${config_file}" <<'PY'
import sys
try:
    import yaml
except ImportError:
    sys.exit(1)
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    doc = yaml.safe_load(f) or {}
meta = {"general", "GENERAL", "auth", "AUTH"}
placeholder = {"key", "xxxx", "xxx", "", None}
for key, val in doc.items():
    if key in meta:
        continue
    if isinstance(val, dict) and val.get("api_key") not in placeholder:
        sys.exit(0)
    if isinstance(val, list) and any(
        isinstance(e, dict) and e.get("api_key") not in placeholder for e in val
    ):
        sys.exit(0)
sys.exit(1)
PY
}
