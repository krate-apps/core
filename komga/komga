#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/komga/komga
# @project KRATE
# @description Komga — GitHub komga-*.jar + Java 17 on loopback with Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_jar
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::fs::env::set "${env_file}" "KOMGA_PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "KOMGA_CONFIG_DIR" "${data_dir}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	_write_komga_run
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_jar
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_jar() {
	local tmpdir jar
	tmpdir="$(mktemp -d)"
	mkdir -p "${install_dir}"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	# Prefer komga-*.jar; never pick checksums or unrelated archives.
	if [[ -f "${tmpdir}/komga.jar" ]]; then
		jar="${tmpdir}/komga.jar"
	else
		jar="$(find "${tmpdir}" -type f -name 'komga-*.jar' -print -quit 2>/dev/null || true)"
	fi
	[[ -n "${jar}" && -f "${jar}" ]] || {
		printf '[%s] komga-*.jar missing after release download\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mv -f "${jar}" "${install_dir}/komga.jar"
	chmod 0644 "${install_dir}/komga.jar"
	_write_komga_run
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}

_write_komga_run() {
	cat >"${install_dir}/komga-run" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
port="${KOMGA_PORT:?}"
config_dir="${KOMGA_CONFIG_DIR:?}"
jar="$(dirname "$0")/komga.jar"
[[ -f "${jar}" ]] || {
	printf 'komga.jar missing at %s\n' "${jar}" >&2
	exit 1
}
exec java -Djava.awt.headless=true \
	-jar "${jar}" \
	--server.address=127.0.0.1 \
	--server.port="${port}" \
	--komga.config-dir="${config_dir}"
EOF
	chmod 0755 "${install_dir}/komga-run"
}
