#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/fetcharr/fetcharr
# @project KRATE
# @description Fetcharr — git clone, npm install, Express UI (default :8124) + Caddy proxy.
# Note: SSDP discovery of Fetch TV works best with LAN reachability (host networking in Docker).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_fetcharr_provision
	_config
	app::lifecycle::record_effective_branch
}

_config() {
	local default_port csrf config_dir server_js
	mkdir -p "${data_dir}/config"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	csrf="${service_apikey:-}"
	[[ -n "${csrf}" && ${#csrf} -ge 32 ]] || csrf="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
	config_dir="${data_dir}/config"
	# Persist SQLite under data_dir (knexfile DB_PATH).
	rm -rf "${install_dir}/config"
	ln -sfn "${config_dir}" "${install_dir}/config"
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "HOST" "127.0.0.1"
	zenfw::fs::env::set "${env_file}" "NODE_ENV" "production"
	zenfw::fs::env::set "${env_file}" "CSRF_SECRET" "${csrf}"
	zenfw::fs::env::set "${env_file}" "DB_PATH" "${config_dir}/state.db"
	# Bind loopback for Caddy (upstream defaults to 0.0.0.0).
	server_js="${install_dir}/src/server.js"
	if [[ -f "${server_js}" ]] && grep -q 'app.listen(PORT' "${server_js}" 2>/dev/null; then
		if ! grep -q 'process.env.HOST' "${server_js}" 2>/dev/null; then
			sed -i 's|app.listen(PORT, async () => {|app.listen(PORT, process.env.HOST || '\''127.0.0.1'\'', async () => {|' "${server_js}"
		fi
	fi
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	# Run migrations once before first start.
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"DB_PATH='${config_dir}/state.db' NODE_ENV=production npx --yes knex migrate:latest" || true
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::generate "${app_name}" false false
	zenfw::service::manage start "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	rm -rf "${install_dir:?}"/* "${install_dir:?}"/.[!.]* 2>/dev/null || true
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_fetcharr_provision
	_config
	app::lifecycle::record_effective_branch
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetcharr_provision() {
	local build_env
	# Upstream engines: node >=22, npm >=11; better-sqlite3 needs native rebuild.
	cat >"${install_dir}/.npmrc" <<'EOF'
engine-strict=false
fund=false
audit=false
EOF
	zenfw::permission::read_exec::set "${install_dir}/.npmrc" "${username}" "${username}"
	build_env="CI=true HUSKY=0 NODE_ENV=development"
	if [[ -f "${install_dir}/package-lock.json" ]]; then
		zenfw::workspace::user::run "${username}" "${install_dir}" \
			"${build_env} npm ci --ignore-scripts" || \
			zenfw::workspace::user::run "${username}" "${install_dir}" "${build_env} npm install --ignore-scripts" || {
			printf '[%s] npm install failed\n' "${app_name}" >&2
			return 1
		}
	else
		zenfw::workspace::user::run "${username}" "${install_dir}" "${build_env} npm install --ignore-scripts" || {
			printf '[%s] npm install failed\n' "${app_name}" >&2
			return 1
		}
	fi
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"${build_env} npm rebuild --ignore-scripts=false better-sqlite3" || {
		printf '[%s] better-sqlite3 rebuild failed\n' "${app_name}" >&2
		return 1
	}
	test -f "${install_dir}/src/server.js"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
}
