#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/lingarr/lingarr
# @project KRATE
# @description Lingarr — Vue client build + dotnet publish Lingarr.Server; SQLite; loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::dependency::apt::install_inline "git curl ca-certificates wget build-essential python3" || true
	_ensure_dotnet_sdk "10.0"
	_lingarr_provision
	zenfw::service::generate "${app_name}" true false
	_config
	app::lifecycle::record_effective_branch
}

_config() {
	local default_port base_path
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	base_path="${url_base:-}"
	[[ "${base_path}" == "/" ]] && base_path=""
	# Upstream stores config under ./config relative to WorkingDirectory.
	if [[ -d "${install_dir}/config" && ! -L "${install_dir}/config" ]]; then
		if [[ ! -e "${data_dir}/.seeded" ]]; then
			cp -a "${install_dir}/config/." "${data_dir}/" 2>/dev/null || true
			: >"${data_dir}/.seeded"
		fi
		rm -rf "${install_dir}/config"
	fi
	ln -sfn "${data_dir}" "${install_dir}/config"
	zenfw::fs::env::set "${env_file}" "ASPNETCORE_URLS" "http://127.0.0.1:${default_port}"
	zenfw::fs::env::set "${env_file}" "ASPNETCORE_ENVIRONMENT" "Production"
	zenfw::fs::env::set "${env_file}" "DB_CONNECTION" "sqlite"
	zenfw::fs::env::set "${env_file}" "SQLITE_DB_PATH" "${data_dir}/local.db"
	zenfw::fs::env::set "${env_file}" "DB_HANGFIRE_SQLITE_PATH" "${data_dir}/Hangfire.db"
	zenfw::fs::env::set "${env_file}" "BASE_PATH" "${base_path}"
	zenfw::fs::env::set "${env_file}" "DOTNET_BUNDLE_EXTRACT_BASE_DIR" "/home/${username}/tmp/${app_name}"
	_wire_servarr_hints || true
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_ensure_dotnet_sdk "10.0"
	_lingarr_provision
	_config
	app::lifecycle::record_effective_branch
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_lingarr_provision() {
	local src publish_dir client_dir bin build_env
	src="${temp_dir}/src"
	publish_dir="${temp_dir}/publish"
	rm -rf "${src}" "${publish_dir}"
	mkdir -p "${src}" "${publish_dir}" "${install_dir}"
	zenfw::git::clone "${app_repo}" "${src}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${src}" "${username}" "${username}"
	client_dir="${src}/Lingarr.Client"
	[[ -d "${client_dir}" ]] || {
		printf '[%s] Lingarr.Client missing after clone\n' "${app_name}" >&2
		return 1
	}
	build_env="CI=true HUSKY=0 NODE_OPTIONS=--max-old-space-size=4096"
	cat >"${client_dir}/.npmrc" <<'EOF'
engine-strict=false
fund=false
audit=false
EOF
	if [[ -f "${client_dir}/package-lock.json" ]]; then
		zenfw::workspace::user::run "${username}" "${client_dir}" \
			"${build_env} npm ci" || \
			zenfw::workspace::user::run "${username}" "${client_dir}" \
				"${build_env} npm install" || {
			printf '[%s] npm install (Lingarr.Client) failed\n' "${app_name}" >&2
			return 1
		}
	else
		zenfw::workspace::user::run "${username}" "${client_dir}" \
			"${build_env} npm install" || {
			printf '[%s] npm install (Lingarr.Client) failed\n' "${app_name}" >&2
			return 1
		}
	fi
	zenfw::workspace::user::run "${username}" "${client_dir}" \
		"${build_env} npm run build" || {
		printf '[%s] Vue client build failed\n' "${app_name}" >&2
		return 1
	}
	mkdir -p "${src}/Lingarr.Server/wwwroot"
	cp -a "${client_dir}/dist/." "${src}/Lingarr.Server/wwwroot/"
	export DOTNET_ROOT="${DOTNET_ROOT:-/usr/share/dotnet}"
	export PATH="${DOTNET_ROOT}:/usr/local/bin:${PATH}"
	command -v dotnet >/dev/null 2>&1 || {
		printf '[%s] dotnet missing\n' "${app_name}" >&2
		return 1
	}
	zenfw::workspace::user::run "${username}" "${src}" \
		"export DOTNET_ROOT='${DOTNET_ROOT}' PATH='${DOTNET_ROOT}:/usr/local/bin:\$PATH' DOTNET_CLI_HOME='/home/${username}/tmp/${app_name}' NUGET_PACKAGES='/home/${username}/.nuget/packages'; \
		dotnet publish Lingarr.Server/Lingarr.Server.csproj -c Release -r linux-x64 --self-contained true -o '${publish_dir}'" || {
		printf '[%s] dotnet publish Lingarr.Server failed\n' "${app_name}" >&2
		return 1
	}
	# Preserve config symlink across updates.
	find "${install_dir}" -mindepth 1 -maxdepth 1 ! -name config -exec rm -rf {} + 2>/dev/null || true
	(
		cd "${publish_dir}"
		find . -mindepth 1 -maxdepth 1 ! -name config -exec cp -a {} "${install_dir}/" \;
	)
	bin="${install_dir}/Lingarr.Server"
	if [[ ! -x "${bin}" ]]; then
		if [[ -f "${install_dir}/Lingarr.Server.dll" ]]; then
			cat >"${bin}" <<'EOF'
#!/usr/bin/env bash
exec dotnet "$(dirname "$0")/Lingarr.Server.dll" "$@"
EOF
			chmod 0755 "${bin}"
		fi
	fi
	chmod 0755 "${bin}" 2>/dev/null || true
	[[ -f "${install_dir}/Lingarr.Server.dll" || -x "${bin}" ]] || {
		printf '[%s] Lingarr.Server publish output missing\n' "${app_name}" >&2
		return 1
	}
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${src}" "${publish_dir}"
}

_wire_servarr_hints() {
	local sibling_env apikey port
	sibling_env="/home/${username}/.krate/applications/radarr.env"
	if [[ -f "${sibling_env}" ]]; then
		apikey="$(zenfw::fs::env::get "${sibling_env}" "RADARR__AUTH__APIKEY" || true)"
		port="$(zenfw::fs::env::get "${sibling_env}" "RADARR__SERVER__PORT" || true)"
		if [[ -n "${apikey}" && -n "${port}" ]]; then
			zenfw::fs::env::set "${env_file}" "RADARR_URL" "http://127.0.0.1:${port}"
			zenfw::fs::env::set "${env_file}" "RADARR_API_KEY" "${apikey}"
		fi
	fi
	sibling_env="/home/${username}/.krate/applications/sonarr.env"
	if [[ -f "${sibling_env}" ]]; then
		apikey="$(zenfw::fs::env::get "${sibling_env}" "SONARR__AUTH__APIKEY" || true)"
		port="$(zenfw::fs::env::get "${sibling_env}" "SONARR__SERVER__PORT" || true)"
		if [[ -n "${apikey}" && -n "${port}" ]]; then
			zenfw::fs::env::set "${env_file}" "SONARR_URL" "http://127.0.0.1:${port}"
			zenfw::fs::env::set "${env_file}" "SONARR_API_KEY" "${apikey}"
		fi
	fi
}

# Ensure a .NET SDK matching channel (lingarr global.json → 10.x). Prefer apt, else official install script.
_ensure_dotnet_sdk() {
	local channel="${1:-10.0}" ver major want script deb
	export DOTNET_ROOT="${DOTNET_ROOT:-/usr/share/dotnet}"
	export PATH="${DOTNET_ROOT}:/usr/local/bin:${PATH}"
	want="${channel%%.*}"
	if command -v dotnet >/dev/null 2>&1; then
		ver="$(dotnet --version 2>/dev/null || true)"
		major="${ver%%.*}"
		if [[ -n "${major}" && "${major}" =~ ^[0-9]+$ && "${major}" -ge "${want}" ]]; then
			return 0
		fi
	fi
	zenfw::dependency::apt::install_inline "dotnet-sdk-${channel}" || \
		zenfw::dependency::apt::install_inline "dotnet-sdk-8.0" || true
	if command -v dotnet >/dev/null 2>&1; then
		ver="$(dotnet --version 2>/dev/null || true)"
		major="${ver%%.*}"
		if [[ -n "${major}" && "${major}" =~ ^[0-9]+$ && "${major}" -ge "${want}" ]]; then
			return 0
		fi
	fi
	deb="$(mktemp --suffix=.deb)"
	if curl -fsSL "https://packages.microsoft.com/config/ubuntu/24.04/packages-microsoft-prod.deb" -o "${deb}" 2>/dev/null || \
		curl -fsSL "https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb" -o "${deb}" 2>/dev/null; then
		dpkg -i "${deb}" >/dev/null 2>&1 || true
		apt-get update -qq >/dev/null 2>&1 || true
		zenfw::dependency::apt::install_inline "dotnet-sdk-${channel}" || true
	fi
	rm -f "${deb}"
	if command -v dotnet >/dev/null 2>&1; then
		ver="$(dotnet --version 2>/dev/null || true)"
		major="${ver%%.*}"
		if [[ -n "${major}" && "${major}" =~ ^[0-9]+$ && "${major}" -ge "${want}" ]]; then
			return 0
		fi
	fi
	script="$(mktemp --suffix=.sh)"
	curl -fsSL https://dot.net/v1/dotnet-install.sh -o "${script}"
	bash "${script}" --channel "${channel}" --install-dir "${DOTNET_ROOT}" || {
		printf '[%s] dotnet-install.sh failed for channel %s\n' "${app_name}" "${channel}" >&2
		rm -f "${script}"
		return 1
	}
	rm -f "${script}"
	ln -sfn "${DOTNET_ROOT}/dotnet" /usr/local/bin/dotnet 2>/dev/null || true
	export PATH="${DOTNET_ROOT}:/usr/local/bin:${PATH}"
	command -v dotnet >/dev/null 2>&1 || {
		printf '[%s] dotnet still missing after install script\n' "${app_name}" >&2
		return 1
	}
}
