#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/ombi/ombi
# @project KRATE
# @description Ombi — GitHub release binary + web UI proxy
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port
	mkdir -p "${data_dir}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port}"
	zenfw::fs::env::set "${env_file}" "OMBI_PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "OMBI_STORAGE" "${data_dir}"
	zenfw::fs::env::set "${env_file}" "OMBI_BASEURL" "${url_base:-/}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::vault::save "${username}.${app_name}" "${user_password}" application
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir bin root
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	bin="$(find "${tmpdir}" -type f -name Ombi -print -quit || true)"
	[[ -n "${bin}" ]] || {
		printf '[%s] Ombi binary not found in release asset\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	root="$(dirname "${bin}")"
	rm -rf "${install_dir:?}"/*
	# Self-contained .NET layout — keep companion files beside Ombi.
	shopt -s dotglob nullglob
	mv "${root}"/* "${install_dir}/"
	shopt -u dotglob nullglob
	chmod 0755 "${install_dir}/Ombi"
	_write_ombi_run
	rm -rf "${tmpdir}"
}

# Wrapper so --baseurl is only passed when url_base is not "/".
_write_ombi_run() {
	cat >"${install_dir}/ombi-run" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
port="${OMBI_PORT:?}"
storage="${OMBI_STORAGE:?}"
baseurl="${OMBI_BASEURL:-/}"
args=(--host "http://127.0.0.1:${port}" --storage "${storage}")
if [[ -n "${baseurl}" && "${baseurl}" != "/" ]]; then
	args+=(--baseurl "${baseurl}")
fi
exec "$(dirname "$0")/Ombi" "${args[@]}"
EOF
	chmod 0755 "${install_dir}/ombi-run"
}
