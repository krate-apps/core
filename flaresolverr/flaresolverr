#!/usr/bin/env bash
# @file applications/apps-community/flaresolverr/flaresolverr
# @project KRATE
# @description FlareSolverr — app handler (binaire Linux depuis GitHub, systemd, flaresolverr.env).
# Natif : tarball PyInstaller + Chromium APT + Xvfb (xvfb-run, HEADLESS=false). Le Chrome du bundle est rangé pour forcer /usr/bin/chromium (même libs que l’OS).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::git::release::get "${install_dir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	zenfw::service::generate "${app_name}" true false
	_config
	_verify
}

_config() {
	_flaresolverr_prepare_bundle
	local default_port
	default_port="${service_default_port}"
	zenfw::fs::env::set "${env_file}" "HOST" "127.0.0.1"
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	for file in "${install_dir}/flaresolverr" "${install_dir}/_internal/chrome/chrome"; do
		[[ -f "${file}" ]] || continue
		zenfw::permission::exec_exec::set "${file}" "${username}" "${username}"
	done
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	rm -rf "${install_dir:?}"/*
	zenfw::git::release::get "${install_dir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	_flaresolverr_prepare_bundle
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_flaresolverr_restore_executable_bits
	zenfw::service::manage restart "${service_unit}"
	_verify
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

_flaresolverr_prepare_bundle() {
	local internal="${install_dir}/_internal"
	[[ -d "${internal}" ]] || return 0
	local bundled_dir="${internal}/chrome"
	local parked_dir="${internal}/chrome.bundled"
	if [[ -d "${bundled_dir}" && ! -e "${bundled_dir}/.krate-wrapper" ]]; then
		if [[ -d "${parked_dir}" ]]; then
			rm -rf "${parked_dir}"
		fi
		mv "${bundled_dir}" "${parked_dir}"
	fi
	mkdir -p "${bundled_dir}"
	cat > "${bundled_dir}/chrome" << 'EOF'
#!/bin/sh
unset LD_LIBRARY_PATH LD_PRELOAD
exec /usr/bin/chromium "$@"
EOF
	zenfw::permission::exec_exec::set "${bundled_dir}/chrome" "${username}" "${username}"
	: > "${bundled_dir}/.krate-wrapper"
}

_verify() {
	local port base resp i
	port="$(printf '%s\n' "${service_default_port:-}" | tr -cd '0-9')"
	[[ -n "${port}" && "${port}" != "0" ]] || {
		printf '[%s] probe: missing listen port after autogen\n' "${app_name}" >&2
		return 1
	}
	base="http://127.0.0.1:${port}/v1"
	for ((i = 1; i <= 90; i++)); do
		if resp="$(curl -fsS --max-time 8 -X POST "${base}" -H 'Content-Type: application/json' \
			--data-raw '{"cmd":"sessions.list"}' 2>/dev/null)" && [[ "${resp}" == *'"sessions"'* ]]; then
			break
		fi
		sleep 1
		[[ "${i}" -eq 90 ]] || continue
		printf '[%s] probe: API did not become ready on %s\n' "${app_name}" "${base}" >&2
		return 1
	done
	resp="$(curl -fsS --max-time 135 -X POST "${base}" -H 'Content-Type: application/json' \
		--data-raw '{"cmd":"request.get","url":"https://www.hetzner.com","maxTimeout":120000}')"
	if ! grep -Eq '"status"[[:space:]]*:[[:space:]]*"ok"' <<< "${resp}"; then
		printf '[%s] probe: request.get(hetzner.com) did not return status ok (check Chromium/Xvfb)\n' "${app_name}" >&2
		printf '%s\n' "${resp}" | head -c 1200 >&2
		printf '\n' >&2
		return 1
	fi
}
