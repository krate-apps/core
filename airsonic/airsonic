#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/airsonic/airsonic
# @project KRATE
# @description Airsonic-Advanced — GitHub airsonic.war + Java 17 on loopback with Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_war
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port ffmpeg_bin lame_bin
	mkdir -p "${data_dir}/transcode" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	ffmpeg_bin="$(command -v ffmpeg 2>/dev/null || true)"
	lame_bin="$(command -v lame 2>/dev/null || true)"
	[[ -n "${ffmpeg_bin}" ]] && ln -sfn "${ffmpeg_bin}" "${data_dir}/transcode/ffmpeg"
	[[ -n "${lame_bin}" ]] && ln -sfn "${lame_bin}" "${data_dir}/transcode/lame"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::fs::env::set "${env_file}" "AIRSONIC_PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "AIRSONIC_HOME" "${data_dir}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	_write_airsonic_run
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_war
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_war() {
	local tmpdir war
	tmpdir="$(mktemp -d)"
	mkdir -p "${install_dir}"
	if zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)" 2>/dev/null; then
		if [[ -f "${tmpdir}/airsonic.war" ]]; then
			war="${tmpdir}/airsonic.war"
		else
			war="$(find "${tmpdir}" -type f -name 'airsonic.war' -print -quit 2>/dev/null || true)"
		fi
	fi
	if [[ -z "${war:-}" || ! -f "${war}" ]]; then
		# Fallback: latest release asset via curl (release::get may miss edge builds).
		curl -fsSL -L -o "${tmpdir}/airsonic.war" \
			"https://github.com/airsonic-advanced/airsonic-advanced/releases/latest/download/airsonic.war"
		war="${tmpdir}/airsonic.war"
	fi
	[[ -f "${war}" ]] || {
		printf '[%s] airsonic.war missing after download\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mv -f "${war}" "${install_dir}/airsonic.war"
	chmod 0644 "${install_dir}/airsonic.war"
	_write_airsonic_run
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}

_write_airsonic_run() {
	cat >"${install_dir}/airsonic-run" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
port="${AIRSONIC_PORT:?}"
home="${AIRSONIC_HOME:?}"
war="$(dirname "$0")/airsonic.war"
[[ -f "${war}" ]] || {
	printf 'airsonic.war missing at %s\n' "${war}" >&2
	exit 1
}
exec java -Djava.awt.headless=true \
	-Dserver.address=127.0.0.1 \
	-Dserver.port="${port}" \
	-Dairsonic.home="${home}" \
	-jar "${war}"
EOF
	chmod 0755 "${install_dir}/airsonic-run"
}
