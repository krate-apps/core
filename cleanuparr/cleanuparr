#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/cleanuparr/cleanuparr
# @project KRATE
# @description Cleanuparr — GitHub release binary + web UI proxy
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port
	mkdir -p "${data_dir}/config" "${data_dir}/logs"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port}"
	zenfw::fs::env::set "${env_file}" "BIND_ADDRESS" "127.0.0.1"
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "BASE_PATH" "${url_base}"
	zenfw::fs::env::set "${env_file}" "CLEANUPARR_CONFIG_PATH" "${data_dir}/config"
	zenfw::fs::env::set "${env_file}" "CLEANUPARR_LOGS_PATH" "${data_dir}/logs"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir bin root
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	if [[ -f "${tmpdir}/Cleanuparr" ]]; then
		root="${tmpdir}"
	else
		bin="$(find "${tmpdir}" -type f -name Cleanuparr -print -quit || true)"
		[[ -n "${bin}" ]] || {
			printf '[%s] Cleanuparr binary not found in release asset\n' "${app_name}" >&2
			rm -rf "${tmpdir}"
			return 1
		}
		root="$(dirname "${bin}")"
	fi
	rm -rf "${install_dir:?}"/*
	# Preserve self-contained layout (binary + companion files).
	shopt -s dotglob nullglob
	mv "${root}"/* "${install_dir}/"
	shopt -u dotglob nullglob
	chmod 0755 "${install_dir}/Cleanuparr"
	rm -rf "${tmpdir}"
}
