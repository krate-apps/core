#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/flexget/flexget
# @project KRATE
# @description FlexGet — uv venv + pip install flexget; daemon + web UI on loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::workspace::uv::install
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_flexget_provision_runtime
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port config_file base
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	config_file="${data_dir}/config.yml"
	base="${url_base%/}"
	[[ "${base}" == "/" ]] && base=""
	if [[ ! -f "${config_file}" ]]; then
		cat >"${config_file}" <<EOF
# FlexGet — add tasks, then restart flexget@${username}.
# Docs: https://flexget.com/
web_server:
  bind: 127.0.0.1
  port: ${default_port}
  web_ui: true
  base_url: "${base}"

schedules:
  - tasks: '*'
    interval:
      hours: 1

tasks: {}
EOF
	else
		_flexget_patch_config "${config_file}" "${default_port}" "${base}"
	fi
	zenfw::fs::env::set "${env_file}" "FLEXGET_PORT" "${default_port}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_flexget_provision_runtime
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_flexget_provision_runtime() {
	printf '3.12\n' >"${install_dir}/.python-version"
	zenfw::workspace::user::run "${username}" "${install_dir}" "uv python install 3.12" || {
		printf '[%s] uv python install 3.12 failed\n' "${app_name}" >&2
		return 1
	}
	zenfw::workspace::venv::create "${install_dir}" "${username}" false
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"UV_PYTHON=3.12 uv pip install --upgrade flexget" || {
		printf '[%s] uv pip install flexget failed\n' "${app_name}" >&2
		return 1
	}
	test -x "${install_dir}/.venv/bin/flexget"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
}

_flexget_patch_config() {
	local config_file="${1:?}" port="${2:?}" base="${3:?}"
	# Stdlib-only: rewrite/insert web_server keys (avoid PyYAML dependency on host).
	python3 - "${config_file}" "${port}" "${base}" <<'PY'
import re
import sys

path, port, base = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(path, encoding="utf-8").read()
block = (
    "web_server:\n"
    f"  bind: 127.0.0.1\n"
    f"  port: {port}\n"
    f"  web_ui: true\n"
    f'  base_url: "{base}"\n'
)
if re.search(r"(?m)^web_server\s*:", text):
    text = re.sub(
        r"(?ms)^web_server\s*:.*?(?=^(?:[^\s#]|\Z))",
        block,
        text,
        count=1,
    )
else:
    text = block + "\n" + text
open(path, "w", encoding="utf-8").write(text)
PY
}
