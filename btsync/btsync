#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/btsync/btsync
# @project KRATE
# @description Resilio Sync (btsync) — proprietary CDN tarball; WebUI on loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_BTSYNC_URL="https://download-cdn.resilio.com/stable/linux/x64/resilio-sync_x64.tar.gz"

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port config_file
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	config_file="${data_dir}/config.json"
	_write_config "${config_file}" "${default_port}"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::fs::env::set "${env_file}" "BTSYNC_PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "BTSYNC_CONFIG" "${config_file}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::private::set "${config_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir bin
	tmpdir="$(mktemp -d)"
	mkdir -p "${install_dir}"
	curl -fsSL -L -o "${tmpdir}/resilio-sync_x64.tar.gz" "${_BTSYNC_URL}"
	tar -xzf "${tmpdir}/resilio-sync_x64.tar.gz" -C "${tmpdir}"
	if [[ -f "${tmpdir}/rslsync" ]]; then
		bin="${tmpdir}/rslsync"
	else
		bin="$(find "${tmpdir}" -type f -name rslsync -print -quit 2>/dev/null || true)"
	fi
	[[ -n "${bin}" && -f "${bin}" ]] || {
		printf '[%s] rslsync binary missing after extract\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mv -f "${bin}" "${install_dir}/rslsync"
	chmod 0755 "${install_dir}/rslsync"
	# Keep vendor license text beside the binary when present.
	[[ -f "${tmpdir}/LICENSE.TXT" ]] && cp -f "${tmpdir}/LICENSE.TXT" "${install_dir}/LICENSE.TXT"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}

_write_config() {
	local config_file="${1:?}" port="${2:?}"
	python3 - "${config_file}" "${port}" "${data_dir}" "${username}" <<'PY'
import json
import os
import sys

path, port, data_dir, username = sys.argv[1:5]
defaults = {
    "device_name": f"krate-{username}-btsync",
    "storage_path": data_dir,
    "listening_port": 0,
    "check_for_updates": False,
    "use_upnp": False,
    "download_limit": 0,
    "upload_limit": 0,
    "webui": {
        "listen": f"127.0.0.1:{port}",
    },
}
data = {}
if os.path.isfile(path):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f) or {}
    except (OSError, json.JSONDecodeError):
        data = {}
merged = dict(defaults)
merged.update(data)
merged["storage_path"] = data_dir
merged["use_upnp"] = False
webui = merged.get("webui") if isinstance(merged.get("webui"), dict) else {}
webui = dict(webui)
webui["listen"] = f"127.0.0.1:{port}"
merged["webui"] = webui
# shared_folders in config disables WebUI — never seed that key.
merged.pop("shared_folders", None)
os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
with open(path, "w", encoding="utf-8") as f:
    json.dump(merged, f, indent=2)
    f.write("\n")
PY
}
