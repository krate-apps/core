#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/duplicati/duplicati
# @project KRATE
# @description Duplicati — linux-x64-gui.zip self-contained; webservice on loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port webroot
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	webroot="${url_base:-/}"
	[[ -n "${webroot}" ]] || webroot="/"
	[[ "${webroot}" == "/" ]] && webroot=""
	zenfw::fs::env::set "${env_file}" "DUPLICATI_PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "DUPLICATI_HOME" "${data_dir}"
	zenfw::fs::env::set "${env_file}" "DUPLICATI_WEBROOT" "${webroot}"
	zenfw::fs::env::set "${env_file}" "DUPLICATI_PASSWORD" "${user_password}"
	zenfw::fs::env::set "${env_file}" "DOTNET_BUNDLE_EXTRACT_BASE_DIR" "/home/${username}/tmp/${app_name}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::vault::save "${username}.${app_name}" "${user_password}" application
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_write_duplicati_run
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir src bin
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	if [[ -f "${tmpdir}/duplicati-server" ]]; then
		src="${tmpdir}"
	else
		bin="$(find "${tmpdir}" -type f -name duplicati-server -print -quit 2>/dev/null || true)"
		[[ -n "${bin}" ]] || {
			printf '[%s] duplicati-server missing after release extract\n' "${app_name}" >&2
			rm -rf "${tmpdir}"
			return 1
		}
		src="$(dirname "${bin}")"
	fi
	mkdir -p "${install_dir}"
	rm -rf "${install_dir:?}"/*
	shopt -s dotglob nullglob
	cp -a "${src}"/* "${install_dir}/"
	shopt -u dotglob nullglob
	chmod 0755 "${install_dir}/duplicati-server"
	[[ -f "${install_dir}/duplicati" ]] && chmod 0755 "${install_dir}/duplicati"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}

# Wrapper so webservice-webroot is omitted when url_base is "/".
_write_duplicati_run() {
	cat >"${install_dir}/duplicati-run" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
port="${DUPLICATI_PORT:?}"
home="${DUPLICATI_HOME:?}"
webroot="${DUPLICATI_WEBROOT:-}"
password="${DUPLICATI_PASSWORD:-}"
args=(
	"--webservice-port=${port}"
	"--webservice-interface=127.0.0.1"
	"--server-datafolder=${home}"
	"--webservice-allowed-hostnames=*"
)
if [[ -n "${webroot}" && "${webroot}" != "/" ]]; then
	args+=("--webservice-webroot=${webroot}")
fi
if [[ -n "${password}" ]]; then
	args+=("--webservice-password=${password}")
fi
exec "$(dirname "$0")/duplicati-server" "${args[@]}"
EOF
	chmod 0755 "${install_dir}/duplicati-run"
}
