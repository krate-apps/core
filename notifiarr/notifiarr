#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/notifiarr/notifiarr
# @project KRATE
# @description Notifiarr — GitHub release binary + TOML config + Caddy proxy
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port config_file hashed_password
	mkdir -p "${data_dir}/logs"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port}"
	[[ -n "${license_key}" ]] || {
		printf '[notifiarr] missing required option: --notifiarr-api-key <key> (get yours at https://notifiarr.com)\n' >&2
		exit 1
	}
	config_file="${data_dir}/notifiarr.conf"
	if [[ ! -f "${config_file}" ]]; then
		zenfw::request::wait::ping "https://raw.githubusercontent.com/Notifiarr/notifiarr/main/examples/notifiarr.conf.example" 30 1000 false
		curl -fsSL "https://raw.githubusercontent.com/Notifiarr/notifiarr/main/examples/notifiarr.conf.example" -o "${config_file}"
	fi
	hashed_password="$(printf '%s' "${user_password}" | sha256sum | awk '{print $1}')"
	sed -i \
		-e "s|^\s*api_key\s*=.*|api_key = \"${license_key}\"|" \
		-e "s|^\s*urlbase\s*=.*|urlbase = \"${url_base}\"|" \
		-e "s|^\s*ui_password\s*=.*|ui_password = \"${username}:${hashed_password}\"|" \
		-e "s|^\s*bind_addr\s*=.*|bind_addr = \"127.0.0.1:${default_port}\"|" \
		"${config_file}"
	zenfw::vault::save "${username}.${app_name}" "${user_password}" application
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	mv "${tmpdir}/notifiarr.amd64.linux" "${install_dir}/notifiarr"
	chmod 0755 "${install_dir}/notifiarr"
	rm -rf "${tmpdir}"
}
