#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/jdownloader/jdownloader
# @project KRATE
# @description JDownloader 2 — download JDownloader.jar; OpenJDK 17 headless; MyJDownloader remote (no proxy).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::dependency::apt::install_inline "openjdk-17-jre-headless" || true
	command -v java >/dev/null 2>&1 || {
		printf '[%s] java binary missing after apt install\n' "${app_name}" >&2
		return 1
	}
	_fetch_jar
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	mkdir -p "${data_dir}" "${install_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	# First-run bootstrap: JD updates itself and writes cfg under WorkingDirectory (install_dir).
	# No web UI / no Caddy — remote control via MyJDownloader after linking the account in the UI once.
	_bootstrap_once || true
	zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	zenfw::dependency::apt::install_inline "openjdk-17-jre-headless" || true
	_fetch_jar
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_jar() {
	local jar_url="http://installer.jdownloader.org/JDownloader.jar"
	mkdir -p "${install_dir}"
	if [[ ! -f "${install_dir}/JDownloader.jar" ]]; then
		curl -fsSL -L -o "${install_dir}/JDownloader.jar" "${jar_url}" || {
			printf '[%s] failed to download JDownloader.jar from %s\n' "${app_name}" "${jar_url}" >&2
			return 1
		}
	fi
	[[ -f "${install_dir}/JDownloader.jar" ]] || {
		printf '[%s] JDownloader.jar missing under %s\n' "${app_name}" "${install_dir}" >&2
		return 1
	}
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
}

# Short headless run so JD can download its core update packages before the long-running service.
_bootstrap_once() {
	local marker="${install_dir}/.krate_bootstrapped"
	[[ -f "${marker}" ]] && return 0
	[[ -f "${install_dir}/JDownloader.jar" ]] || return 1
	# Allow first-run update; ignore non-zero (JD may exit after update restart request).
	su -s /bin/bash -c \
		"cd '${install_dir}' && timeout 120 java -Djava.awt.headless=true -jar JDownloader.jar -norestart >/dev/null 2>&1 || true" \
		- "${username}" || true
	: >"${marker}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
}
