#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/pyload/pyload
# @project KRATE
# @description pyLoad — uv venv + pip install pyload-ng; web UI on loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::workspace::uv::install
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_pyload_provision_runtime
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port cfg_file prefix
	mkdir -p "${data_dir}/downloads" "${data_dir}/settings" "${temp_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	cfg_file="${data_dir}/settings/pyload.cfg"
	prefix="${url_base%/}"
	[[ "${prefix}" == "/" ]] && prefix=""
	# Seed default cfg from package if missing (first start also copies it).
	if [[ ! -f "${cfg_file}" ]]; then
		_pyload_seed_cfg "${cfg_file}" || true
	fi
	if [[ -f "${cfg_file}" ]]; then
		_pyload_patch_cfg "${cfg_file}" "${default_port}" "${prefix}"
	fi
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_pyload_provision_runtime
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_pyload_provision_runtime() {
	printf '3.12\n' >"${install_dir}/.python-version"
	zenfw::workspace::user::run "${username}" "${install_dir}" "uv python install 3.12" || {
		printf '[%s] uv python install 3.12 failed\n' "${app_name}" >&2
		return 1
	}
	zenfw::workspace::venv::create "${install_dir}" "${username}" false
	# pyload-ng is still pre-release on PyPI; --pre is required for install.
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"UV_PYTHON=3.12 uv pip install --upgrade --pre 'pyload-ng[all]'" || {
		printf '[%s] uv pip install pyload-ng failed\n' "${app_name}" >&2
		return 1
	}
	test -x "${install_dir}/.venv/bin/pyload"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
}

_pyload_seed_cfg() {
	local cfg_file="${1:?}"
	local default_cfg
	default_cfg="$("${install_dir}/.venv/bin/python" - <<'PY'
import importlib.util
import os
spec = importlib.util.find_spec("pyload")
if not spec or not spec.submodule_search_locations:
    raise SystemExit(1)
pkg = spec.submodule_search_locations[0]
path = os.path.join(pkg, "core", "config", "default.cfg")
print(path if os.path.isfile(path) else "")
PY
)" || return 1
	[[ -n "${default_cfg}" && -f "${default_cfg}" ]] || return 1
	mkdir -p "$(dirname "${cfg_file}")"
	cp "${default_cfg}" "${cfg_file}"
	chmod 600 "${cfg_file}"
}

_pyload_patch_cfg() {
	local cfg_file="${1:?}" port="${2:?}" prefix="${3:?}"
	python3 - "${cfg_file}" "${port}" "${prefix}" <<'PY'
import re
import sys

path, port, prefix = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(path, encoding="utf-8").read()

def set_webui_opt(src: str, opt: str, value: str) -> str:
    # Match lines like: ip host : "IP address" = localhost
    pat = re.compile(
        rf'(?m)^(?P<head>\s*\S+\s+{re.escape(opt)}\s*:\s*"[^"]*"\s*=\s?).*$'
    )
    m = pat.search(src)
    if not m:
        return src
    return pat.sub(rf'\g<head>{value}', src, count=1)

# Limit edits to the webui section when present.
parts = re.split(r'(?m)^(webui\s+-\s+"Web Interface":)', text, maxsplit=1)
if len(parts) == 3:
    head, title, rest = parts
    next_sec = re.search(r'(?m)^\S.+\s+-\s+".+":', rest)
    if next_sec:
        section, tail = rest[: next_sec.start()], rest[next_sec.start() :]
    else:
        section, tail = rest, ""
    section = set_webui_opt(section, "host", "127.0.0.1")
    section = set_webui_opt(section, "port", str(port))
    section = set_webui_opt(section, "prefix", prefix)
    text = head + title + section + tail
else:
    text = set_webui_opt(text, "host", "127.0.0.1")
    text = set_webui_opt(text, "port", str(port))
    text = set_webui_opt(text, "prefix", prefix)

open(path, "w", encoding="utf-8").write(text)
PY
}
