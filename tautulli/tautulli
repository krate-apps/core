#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps-community/tautulli/tautulli
# @project KRATE
# @description Tautulli — app handler (Python source via git release, INI config, no Servarr API).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::workspace::uv::install
	zenfw::git::release::get "${install_dir}" "${app_repo}" "${is_prerelease}" "source"
	printf '3.13\n' > "${install_dir}/.python-version"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::workspace::user::run "${username}" "${install_dir}" "uv python install 3.13" || true
	zenfw::workspace::venv::create "${install_dir}" "${username}" false
	_tautulli_install_venv_deps || return 1
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
	zenfw::service::generate "${app_name}" true false
	_config
}

_tautulli_install_venv_deps() {
	# Drop python_version markers uv cannot apply on 3.13 (e.g. backports.zoneinfo).
	python3 - "${install_dir}/requirements.txt" "${install_dir}/.krate-requirements.txt" <<'PY'
import sys
from pathlib import Path

src, dst = Path(sys.argv[1]), Path(sys.argv[2])
lines = []
for raw in src.read_text(encoding="utf-8").splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    if ";python_version" in line.replace(" ", ""):
        continue
    lines.append(line)
dst.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
	zenfw::workspace::user::run "${username}" "${install_dir}" "uv pip install -r .krate-requirements.txt" || {
		printf '[%s] uv pip install failed in %s\n' "${app_name}" "${install_dir}" >&2
		return 1
	}
}

_config() {
	local apikey default_port config_file
	mkdir -p "${data_dir}/backups" "${data_dir}/cache" "${data_dir}/exports" "${data_dir}/logs" "${data_dir}/newsletters"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	apikey="${service_apikey}"
	default_port="${service_default_port}"
	config_file="${data_dir}/config.ini"
	cat > "${config_file}" <<-EOF
		[General]
		first_run_complete = 1
		check_github = 0
		launch_browser = 0
		api_enabled = 1
		api_key = ${apikey}
		http_host = 127.0.0.1
		http_port = ${default_port}
		http_root = ${url_base}
		http_proxy = 1
		http_username = ${username}
		http_password = ${user_password}
		http_hash_password = 1
		http_hashed_password = 0
		backup_dir = ${data_dir}/backups
		cache_dir = ${data_dir}/cache
		export_dir = ${data_dir}/exports
		log_dir = ${data_dir}/logs
		newsletter_dir = ${data_dir}/newsletters
	EOF
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::set "${config_file}" "640" "700" "${username}" "${username}"
	zenfw::vault::save "${username}.${app_name}" "${user_password}" application
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	zenfw::git::release::get "${install_dir}" "${app_repo}" "${is_prerelease}" "source"
	printf '3.13\n' > "${install_dir}/.python-version"
	zenfw::workspace::venv::create "${install_dir}" "${username}" false
	_tautulli_install_venv_deps || return 1
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}
