#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/unpackerr/unpackerr
# @project KRATE
# @description Unpackerr — GitHub release binary; daemon, no web UI, no proxy
# shellcheck disable=SC2154
set -euo pipefail

# Map of KRATE app id → unpackerr UN_* prefix and instance index. radarr4k/sonarr4k
# are exposed as the second instance (index 1) of their parent Servarr family.
readonly _SERVARR_MAP=(
	"radarr:RADARR:0"
	"sonarr:SONARR:0"
	"lidarr:LIDARR:0"
	"readarr:READARR:0"
	"whisparr:WHISPARR:0"
	"prowlarr:PROWLARR:0"
	"radarr4k:RADARR:1"
	"sonarr4k:SONARR:1"
)

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	mkdir -p "${data_dir}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	_wire_servarr_env
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

# Discovers Servarr siblings installed for the same user via their .krate/applications/<app>.env
# files and writes corresponding UN_<APP>_<INDEX>_* entries into unpackerr.env.
_wire_servarr_env() {
	local entry app_id un_prefix idx sibling_env apikey port urlbase scheme=http
	for entry in "${_SERVARR_MAP[@]}"; do
		IFS=':' read -r app_id un_prefix idx <<< "${entry}"
		sibling_env="/home/${username}/.krate/applications/${app_id}.env"
		[[ -f "${sibling_env}" ]] || continue
		apikey="$(zenfw::fs::env::get "${sibling_env}" "${un_prefix}__AUTH__APIKEY" || true)"
		port="$(zenfw::fs::env::get "${sibling_env}" "${un_prefix}__SERVER__PORT" || true)"
		urlbase="$(zenfw::fs::env::get "${sibling_env}" "${un_prefix}__SERVER__URLBASE" || true)"
		[[ -z "${apikey}" || -z "${port}" ]] && continue
		zenfw::fs::env::set "${env_file}" "UN_${un_prefix}_${idx}_API_KEY" "${apikey}"
		zenfw::fs::env::set "${env_file}" "UN_${un_prefix}_${idx}_URL" "${scheme}://127.0.0.1:${port}${urlbase}"
	done
}

_fetch_binary() {
	local tmpdir
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	if [[ -f "${tmpdir}/unpackerr.amd64.linux" ]]; then
		mv "${tmpdir}/unpackerr.amd64.linux" "${install_dir}/unpackerr"
	elif [[ -f "${tmpdir}/unpackerr" ]]; then
		mv "${tmpdir}/unpackerr" "${install_dir}/unpackerr"
	fi
	chmod 0755 "${install_dir}/unpackerr"
	rm -rf "${tmpdir}"
}
