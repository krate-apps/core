#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/audiobookshelf/audiobookshelf
# @project KRATE
# @description Audiobookshelf — git clone, Nuxt client generate + Node server (no GH release assets).
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_audiobookshelf_provision
	_config
	app::lifecycle::record_effective_branch
}

_config() {
	local default_port config_dir metadata_dir media_dir base
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	config_dir="${data_dir}/config"
	metadata_dir="${data_dir}/metadata"
	media_dir="/home/${username}/media/audiobooks"
	mkdir -p "${config_dir}" "${metadata_dir}" "${media_dir}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${media_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	base="${url_base:-/audiobookshelf}"
	[[ "${base}" == "/" ]] && base=""
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "HOST" "127.0.0.1"
	zenfw::fs::env::set "${env_file}" "CONFIG_PATH" "${config_dir}"
	zenfw::fs::env::set "${env_file}" "METADATA_PATH" "${metadata_dir}"
	zenfw::fs::env::set "${env_file}" "ROUTER_BASE_PATH" "${base}"
	zenfw::fs::env::set "${env_file}" "NODE_ENV" "production"
	zenfw::fs::env::set "${env_file}" "SOURCE" "krate"
	zenfw::fs::env::set "${env_file}" "CYPRESS_INSTALL_BINARY" "0"
	if [[ -f "${install_dir}/lib/libnusqlite3.so" ]]; then
		zenfw::fs::env::set "${env_file}" "NUSQLITE3_PATH" "${install_dir}/lib/libnusqlite3.so"
		zenfw::fs::env::set "${env_file}" "NUSQLITE3_DIR" "${install_dir}/lib"
	fi
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::generate "${app_name}" false false
	zenfw::service::manage start "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	rm -rf "${install_dir:?}"/* "${install_dir:?}"/.[!.]* 2>/dev/null || true
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_audiobookshelf_provision
	_config
	app::lifecycle::record_effective_branch
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_audiobookshelf_write_npmrc() {
	local target="${1:?}"
	cat >"${target}/.npmrc" <<'EOF'
engine-strict=false
strict-dep-builds=false
block-exotic-subdeps=false
use-node-version=20.19.0
manage-package-manager-versions=true
fund=false
audit=false
only-built-dependencies[]=sqlite3
EOF
	zenfw::permission::read_exec::set "${target}/.npmrc" "${username}" "${username}"
}

_audiobookshelf_fetch_nusqlite3() {
	local arch zip_name tmpdir url
	case "$(uname -m)" in
	x86_64 | amd64) zip_name="libnusqlite3-linux-x64.zip" ;;
	aarch64 | arm64) zip_name="libnusqlite3-linux-arm64.zip" ;;
	*) return 0 ;;
	esac
	url="https://github.com/mikiher/nunicode-sqlite/releases/download/v1.2/${zip_name}"
	tmpdir="$(mktemp -d)"
	if curl -fsSL -o "${tmpdir}/lib.zip" "${url}"; then
		mkdir -p "${install_dir}/lib"
		unzip -qo "${tmpdir}/lib.zip" -d "${install_dir}/lib" 2>/dev/null || true
		# Normalize to libnusqlite3.so if the archive nests the .so
		if [[ ! -f "${install_dir}/lib/libnusqlite3.so" ]]; then
			find "${install_dir}/lib" -type f -name 'libnusqlite3.so' -exec cp -f {} "${install_dir}/lib/libnusqlite3.so" \; -quit 2>/dev/null || true
		fi
	fi
	rm -rf "${tmpdir}"
	[[ -f "${install_dir}/lib/libnusqlite3.so" ]] || return 0
	zenfw::permission::read_exec::set "${install_dir}/lib" "${username}" "${username}"
}

_audiobookshelf_provision() {
	local build_env client_dir pnpm_cmd
	client_dir="${install_dir}/client"
	zenfw::workspace::pnpm::prepare "${username}"
	_audiobookshelf_write_npmrc "${install_dir}"
	_audiobookshelf_write_npmrc "${client_dir}"
	build_env="PNPM_HOME=/home/${username}/.local/share/pnpm CI=true HUSKY=0 CYPRESS_INSTALL_BINARY=0"
	build_env+=" NODE_ENV=production NODE_OPTIONS=--max-old-space-size=6144"
	# Client: Nuxt static generate → client/dist (same as upstream Docker stage).
	zenfw::workspace::node::build "${client_dir}" "${username}" generate "${build_env}" || {
		printf '[%s] client generate failed\n' "${app_name}" >&2
		return 1
	}
	test -d "${client_dir}/dist"
	# Server: production deps (sqlite3 native build via only-built-dependencies).
	zenfw::workspace::node::convert "${install_dir}" "${username}"
	zenfw::workspace::pnpm::node "${install_dir}" "${username}" "${build_env}"
	pnpm_cmd="export PNPM_HOME='/home/${username}/.local/share/pnpm'; export CI=true HUSKY=0 CYPRESS_INSTALL_BINARY=0;"
	pnpm_cmd+=" export NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096;"
	pnpm_cmd+=" export PATH=\"\${PNPM_HOME}/bin:\${PNPM_HOME}:\$PATH\";"
	pnpm_cmd+=" if [ -x \"\${PNPM_HOME}/nodejs/current/bin/node\" ]; then export PATH=\"\${PNPM_HOME}/nodejs/current/bin:\$PATH\";"
	pnpm_cmd+=" elif [ -d \"\${PNPM_HOME}/nodejs\" ]; then _nb=\$(find \"\${PNPM_HOME}/nodejs\" -maxdepth 3 -type f -name node 2>/dev/null | head -n1);"
	pnpm_cmd+=" [ -n \"\$_nb\" ] && export PATH=\"\${_nb%/*}:\$PATH\"; fi;"
	zenfw::workspace::user::run "${username}" "${install_dir}" \
		"${pnpm_cmd} pnpm install --prod --config.confirmModulesPurge=false" || {
		printf '[%s] server pnpm install --prod failed\n' "${app_name}" >&2
		return 1
	}
	test -f "${install_dir}/index.js"
	test -d "${install_dir}/node_modules"
	_audiobookshelf_fetch_nusqlite3 || true
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
}
