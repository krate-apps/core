#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/rclone/rclone
# @project KRATE
# @description rclone — linux-amd64.zip; rcd + web GUI on loopback with Caddy proxy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port rc_pass baseurl
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	rc_pass="${user_password}"
	# rclone --rc-baseurl is a path prefix without leading slash.
	baseurl="${url_base#/}"
	baseurl="${baseurl%/}"
	[[ -f "${env_file}" ]] || : >"${env_file}"
	touch "${data_dir}/rclone.conf"
	zenfw::fs::env::set "${env_file}" "RCLONE_CONFIG" "${data_dir}/rclone.conf"
	zenfw::fs::env::set "${env_file}" "RCLONE_RC_ADDR" "127.0.0.1:${default_port}"
	zenfw::fs::env::set "${env_file}" "RCLONE_RC_USER" "${username}"
	zenfw::fs::env::set "${env_file}" "RCLONE_RC_PASS" "${rc_pass}"
	zenfw::fs::env::set "${env_file}" "RCLONE_RC_BASEURL" "${baseurl}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::private::set "${data_dir}/rclone.conf" "${username}" "${username}"
	zenfw::vault::save "${username}.${app_name}" "${rc_pass}" application
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir bin
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	if [[ -f "${tmpdir}/rclone" ]]; then
		bin="${tmpdir}/rclone"
	else
		bin="$(find "${tmpdir}" -type f -name rclone -print -quit 2>/dev/null || true)"
	fi
	[[ -n "${bin}" && -f "${bin}" ]] || {
		printf '[%s] rclone binary missing after release extract\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mv "${bin}" "${install_dir}/rclone"
	chmod 0755 "${install_dir}/rclone"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}
