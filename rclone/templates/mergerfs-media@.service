[Unit]
Description=mergerfs media union for %i (cache + cloud under /run/krate-rclone)
Documentation=https://github.com/trapexit/mergerfs
After=network-online.target rclone-mount@%i.service
Wants=network-online.target rclone-mount@%i.service

[Service]
Type=forking
Environment=RCLONE_INSTANCE=%i
ExecStartPre=/usr/lib/krate/rclone/rclone-unit.sh media pre %i
ExecStart=/usr/lib/krate/rclone/rclone-unit.sh media start %i
ExecStop=/usr/lib/krate/rclone/rclone-unit.sh media stop %i
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
