#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/reiverr/reiverr
# @project KRATE
# @description Reiverr — git clone, npm build (Svelte + Nest), production server + Caddy proxy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_reiverr_provision
	_config
	app::lifecycle::record_effective_branch
}

_config() {
	local default_port secret
	mkdir -p "${data_dir}/config" "${data_dir}/plugins"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	secret="${service_apikey:-}"
	[[ -n "${secret}" ]] || secret="$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
	# Persist config/plugins under data_dir (upstream uses ./config relative to backend cwd).
	rm -rf "${install_dir}/backend/config" "${install_dir}/backend/plugins"
	ln -sfn "${data_dir}/config" "${install_dir}/backend/config"
	ln -sfn "${data_dir}/plugins" "${install_dir}/backend/plugins"
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "HOST" "127.0.0.1"
	zenfw::fs::env::set "${env_file}" "NODE_ENV" "production"
	zenfw::fs::env::set "${env_file}" "SECRET" "${secret}"
	zenfw::fs::env::set "${env_file}" "ADMIN_USERNAME" "${username}"
	zenfw::fs::env::set "${env_file}" "ADMIN_PASSWORD" "${user_password}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::generate "${app_name}" false false
	zenfw::service::manage start "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	rm -rf "${install_dir:?}"/* "${install_dir:?}"/.[!.]* 2>/dev/null || true
	zenfw::git::clone "${app_repo}" "${install_dir}" "$(app::update_branch)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_reiverr_provision
	_config
	app::lifecycle::record_effective_branch
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_reiverr_provision() {
	local main_ts build_env
	main_ts="${install_dir}/backend/src/main.ts"
	# Upstream hardcodes listen(9494); honor PORT/HOST for KRATE loopback + proxy.
	if [[ -f "${main_ts}" ]] && grep -q 'app.listen(9494)' "${main_ts}" 2>/dev/null; then
		sed -i 's|await app.listen(9494);|await app.listen(Number(process.env.PORT || 9494), process.env.HOST || '\''127.0.0.1'\'');|' "${main_ts}"
	fi
	build_env="CI=true HUSKY=0 NODE_OPTIONS=--max-old-space-size=4096"
	zenfw::workspace::user::run "${username}" "${install_dir}" "${build_env} npm install" || {
		printf '[%s] npm install (root) failed\n' "${app_name}" >&2
		return 1
	}
	zenfw::workspace::user::run "${username}" "${install_dir}" "${build_env} npm install --prefix backend" || {
		printf '[%s] npm install (backend) failed\n' "${app_name}" >&2
		return 1
	}
	zenfw::workspace::user::run "${username}" "${install_dir}" "${build_env} npm run build" || {
		printf '[%s] npm run build failed\n' "${app_name}" >&2
		return 1
	}
	test -f "${install_dir}/backend/dist/src/main.js" || test -f "${install_dir}/backend/dist/main.js"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
}
