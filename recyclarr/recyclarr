#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/recyclarr/recyclarr
# @project KRATE
# @description Recyclarr — GitHub release binary; oneshot TRaSH sync (no web UI)
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local config_file
	mkdir -p "${data_dir}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	config_file="${data_dir}/recyclarr.yml"
	if [[ ! -f "${config_file}" ]]; then
		cat >"${config_file}" <<'EOF'
# Recyclarr — edit and add Sonarr/Radarr instances, then:
#   systemctl start recyclarr@USERNAME
# Docs: https://recyclarr.dev/guide/getting-started/
sonarr: {}
radarr: {}
EOF
	fi
	_wire_servarr_hints
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::service::manage start "${service_unit}" 2>/dev/null || true
}

_update() {
	_fetch_binary
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

_wire_servarr_hints() {
	local sibling_env apikey port app_id
	for app_id in sonarr radarr; do
		sibling_env="/home/${username}/.krate/applications/${app_id}.env"
		[[ -f "${sibling_env}" ]] || continue
		case "${app_id}" in
		sonarr)
			apikey="$(zenfw::fs::env::get "${sibling_env}" "SONARR__AUTH__APIKEY" || true)"
			port="$(zenfw::fs::env::get "${sibling_env}" "SONARR__SERVER__PORT" || true)"
			;;
		radarr)
			apikey="$(zenfw::fs::env::get "${sibling_env}" "RADARR__AUTH__APIKEY" || true)"
			port="$(zenfw::fs::env::get "${sibling_env}" "RADARR__SERVER__PORT" || true)"
			;;
		esac
		[[ -z "${apikey}" || -z "${port}" ]] && continue
		zenfw::fs::env::set "${env_file}" "KRATE_HINT_${app_id^^}_API_KEY" "${apikey}"
		zenfw::fs::env::set "${env_file}" "KRATE_HINT_${app_id^^}_URL" "http://127.0.0.1:${port}"
	done
}

_fetch_binary() {
	local tmpdir bin
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	if [[ -f "${tmpdir}/recyclarr" ]]; then
		mv "${tmpdir}/recyclarr" "${install_dir}/recyclarr"
	else
		bin="$(find "${tmpdir}" -type f -name recyclarr -print -quit || true)"
		[[ -n "${bin}" ]] && mv "${bin}" "${install_dir}/recyclarr"
	fi
	chmod 0755 "${install_dir}/recyclarr"
	rm -f "${install_dir}"/*.xml 2>/dev/null || true
	rm -rf "${tmpdir}"
}
