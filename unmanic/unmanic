#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/unmanic/unmanic
# @project KRATE
# @description Unmanic — uv venv + pip install unmanic; web UI on loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::workspace::uv::install
	rm -rf "${install_dir:?}" 2>/dev/null || true
	mkdir -p "${install_dir}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	_unmanic_provision_runtime
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port
	mkdir -p \
		"${data_dir}/config" \
		"${data_dir}/plugins" \
		"${data_dir}/userdata" \
		"${data_dir}/logs" \
		"${temp_dir}/cache" \
		"$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	_unmanic_patch_settings "${data_dir}/config/settings.json" "${default_port}"
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_unmanic_provision_runtime
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_unmanic_provision_runtime() {
	local src_dir
	printf '3.12\n' >"${install_dir}/.python-version"
	zenfw::workspace::user::run "${username}" "${install_dir}" "uv python install 3.12" || {
		printf '[%s] uv python install 3.12 failed\n' "${app_name}" >&2
		return 1
	}
	zenfw::workspace::venv::create "${install_dir}" "${username}" false
	# Prefer PyPI wheel (avoids frontend build from source). Fall back to git+uv.
	if ! zenfw::workspace::user::run "${username}" "${install_dir}" \
		"UV_PYTHON=3.12 uv pip install --upgrade unmanic"; then
		printf '[%s] uv pip install unmanic failed; trying git source\n' "${app_name}" >&2
		src_dir="${install_dir}/src"
		rm -rf "${src_dir}"
		mkdir -p "${src_dir}"
		zenfw::git::clone "${app_repo}" "${src_dir}" "$(app::update_branch)"
		[[ -f "${src_dir}/requirements.txt" ]] || {
			printf '[%s] requirements.txt missing in %s\n' "${app_name}" "${src_dir}" >&2
			return 1
		}
		zenfw::workspace::user::run "${username}" "${install_dir}" \
			"UV_PYTHON=3.12 uv pip install -r ${src_dir}/requirements.txt" || {
			printf '[%s] uv pip install -r requirements.txt failed\n' "${app_name}" >&2
			return 1
		}
		zenfw::workspace::user::run "${username}" "${src_dir}" \
			"UV_PYTHON=3.12 uv pip install ." || {
			printf '[%s] uv pip install . (unmanic source) failed\n' "${app_name}" >&2
			return 1
		}
	fi
	test -x "${install_dir}/.venv/bin/unmanic"
	zenfw::permission::exec_exec::set "${install_dir}/.venv" "${username}" "${username}"
}

_unmanic_patch_settings() {
	local settings_file="${1:?}" port="${2:?}"
	[[ -f "${settings_file}" ]] || return 0
	python3 - "${settings_file}" "${port}" <<'PY'
import json
import sys

path, port = sys.argv[1], int(sys.argv[2])
try:
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, json.JSONDecodeError):
    sys.exit(0)
if not isinstance(data, dict):
    sys.exit(0)
data["ui_port"] = port
data["ui_address"] = "127.0.0.1"
with open(path, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")
PY
}
