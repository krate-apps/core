#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/prefetcharr/prefetcharr
# @project KRATE
# @description Prefetcharr — cargo install from git; TOML config; daemon, no web UI / no proxy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::dependency::apt::install_inline "curl ca-certificates build-essential pkg-config" || true
	_ensure_rustup
	_cargo_install
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local config_file
	mkdir -p "${data_dir}/log" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	config_file="${data_dir}/config.toml"
	if [[ ! -f "${config_file}" ]]; then
		cat >"${config_file}" <<EOF
interval = 900
log_dir = "${data_dir}/log"
log_level = "Info"
prefetch_num = 2
request_seasons = true
append_to_queue = false
connection_retries = 6

[media_server]
type = "Jellyfin"
url = "http://127.0.0.1:8096"
api_key = ""

[sonarr]
url = "http://127.0.0.1:8989"
api_key = ""
EOF
		_wire_servarr_hints "${config_file}" || true
	fi
	[[ -f "${env_file}" ]] || : >"${env_file}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_ensure_rustup
	_cargo_install
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_ensure_rustup() {
	local cargo_bin rustup_init
	export CARGO_HOME="/home/${username}/.cargo"
	export RUSTUP_HOME="/home/${username}/.rustup"
	mkdir -p "${CARGO_HOME}" "${RUSTUP_HOME}"
	zenfw::permission::read_exec::set "${CARGO_HOME}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${RUSTUP_HOME}" "${username}" "${username}"
	cargo_bin="${CARGO_HOME}/bin/cargo"
	if [[ -x "${cargo_bin}" ]]; then
		return 0
	fi
	if command -v cargo >/dev/null 2>&1; then
		return 0
	fi
	rustup_init="$(mktemp)"
	curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o "${rustup_init}"
	zenfw::workspace::user::run "${username}" "/home/${username}" \
		"CARGO_HOME='${CARGO_HOME}' RUSTUP_HOME='${RUSTUP_HOME}' sh '${rustup_init}' -y --default-toolchain stable" || {
		printf '[%s] rustup install failed\n' "${app_name}" >&2
		rm -f "${rustup_init}"
		return 1
	}
	rm -f "${rustup_init}"
	[[ -x "${cargo_bin}" ]] || command -v cargo >/dev/null 2>&1 || {
		printf '[%s] cargo missing after rustup\n' "${app_name}" >&2
		return 1
	}
}

_cargo_install() {
	local cargo_bin path_prefix repo
	export CARGO_HOME="/home/${username}/.cargo"
	export RUSTUP_HOME="/home/${username}/.rustup"
	cargo_bin="${CARGO_HOME}/bin/cargo"
	[[ -x "${cargo_bin}" ]] || cargo_bin="$(command -v cargo)"
	[[ -n "${cargo_bin}" && -x "${cargo_bin}" ]] || {
		printf '[%s] cargo not found\n' "${app_name}" >&2
		return 1
	}
	path_prefix="${CARGO_HOME}/bin"
	repo="${app_repo:-https://github.com/p-hueber/prefetcharr}"
	mkdir -p "${install_dir}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	# Prefer cargo install --git --root; fall back to clone + release build into install_dir/bin.
	if zenfw::workspace::user::run "${username}" "/home/${username}" \
		"export PATH='${path_prefix}:\$PATH' CARGO_HOME='${CARGO_HOME}' RUSTUP_HOME='${RUSTUP_HOME}'; \
		'${cargo_bin}' install --force --git '${repo}' --root '${install_dir}'"; then
		:
	else
		local src
		src="${temp_dir}/src"
		rm -rf "${src}"
		mkdir -p "${src}"
		zenfw::git::clone "${repo}" "${src}" "$(app::update_branch)"
		zenfw::permission::read_exec::set "${src}" "${username}" "${username}"
		zenfw::workspace::user::run "${username}" "${src}" \
			"export PATH='${path_prefix}:\$PATH' CARGO_HOME='${CARGO_HOME}' RUSTUP_HOME='${RUSTUP_HOME}'; \
			'${cargo_bin}' build --release" || {
			printf '[%s] cargo build --release failed\n' "${app_name}" >&2
			return 1
		}
		mkdir -p "${install_dir}/bin"
		install -m 0755 "${src}/target/release/prefetcharr" "${install_dir}/bin/prefetcharr"
	fi
	[[ -x "${install_dir}/bin/prefetcharr" ]] || {
		printf '[%s] binary missing at %s/bin/prefetcharr\n' "${app_name}" "${install_dir}" >&2
		return 1
	}
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
}

# Best-effort: fill Sonarr / Jellyfin API keys from sibling KRATE env files.
_wire_servarr_hints() {
	local config_file="${1:?}" sibling_env sonarr_key sonarr_port jelly_key jelly_port
	[[ -f "${config_file}" ]] || return 0
	sonarr_key="" sonarr_port="" jelly_key="" jelly_port="8096"
	sibling_env="/home/${username}/.krate/applications/sonarr.env"
	if [[ -f "${sibling_env}" ]]; then
		sonarr_key="$(zenfw::fs::env::get "${sibling_env}" "SONARR__AUTH__APIKEY" || true)"
		sonarr_port="$(zenfw::fs::env::get "${sibling_env}" "SONARR__SERVER__PORT" || true)"
	fi
	sibling_env="/home/${username}/.krate/applications/jellyfin.env"
	if [[ -f "${sibling_env}" ]]; then
		jelly_key="$(zenfw::fs::env::get "${sibling_env}" "JELLYFIN__APIKEY" || true)"
		[[ -z "${jelly_key}" ]] && jelly_key="$(zenfw::fs::env::get "${sibling_env}" "JELLYFIN_API_KEY" || true)"
		jelly_port="$(zenfw::fs::env::get "${sibling_env}" "JELLYFIN__PORT" || true)"
		[[ -z "${jelly_port}" ]] && jelly_port="$(zenfw::fs::env::get "${sibling_env}" "JELLYFIN_PORT" || true)"
		: "${jelly_port:=8096}"
	fi
	python3 - "${config_file}" "${sonarr_port}" "${sonarr_key}" "${jelly_port}" "${jelly_key}" <<'PY' || true
import sys
path, sport, skey, jport, jkey = sys.argv[1:6]
text = open(path, encoding="utf-8").read()

def patch_section(src, header, replacements):
    marker = f"[{header}]"
    if marker not in src:
        return src
    head, rest = src.split(marker, 1)
    block, sep, tail = rest.partition("\n[")
    for old, new in replacements:
        if old and new is not None and new != "":
            block = block.replace(old, new, 1)
    out = head + marker + block
    if sep:
        out += sep + tail
    return out

if sport and skey:
    text = patch_section(text, "sonarr", [
        ('url = "http://127.0.0.1:8989"', f'url = "http://127.0.0.1:{sport}"'),
        ('api_key = ""', f'api_key = "{skey}"'),
    ])
if jkey:
    text = patch_section(text, "media_server", [
        ('url = "http://127.0.0.1:8096"', f'url = "http://127.0.0.1:{jport}"'),
        ('api_key = ""', f'api_key = "{jkey}"'),
    ])
open(path, "w", encoding="utf-8").write(text)
PY
}
