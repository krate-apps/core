#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/autobrr/autobrr
# @project KRATE
# @description Autobrr — GitHub release binary + TOML config + autobrrctl create-user
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
	_secure
}

_config() {
	local default_port config_file session_secret log_level
	mkdir -p "${data_dir}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port}"
	log_level="INFO"
	[[ "${branch,,}" == "beta" ]] && log_level="DEBUG"
	config_file="${data_dir}/config.toml"
	if [[ ! -f "${config_file}" ]]; then
		session_secret="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 64)"
		cat >"${config_file}" <<TCON
host = "127.0.0.1"
port = ${default_port}
baseUrl = "${url_base}/"
sessionSecret = "${session_secret}"
checkForUpdates = false
logPath = "${data_dir}/autobrr.log"
logLevel = "${log_level}"
logMaxSize = 50
logMaxBackups = 3
databaseMaxBackups = 5
oidcEnabled = false
TCON
		chmod 0600 "${config_file}"
	else
		sed -i \
			-e "s|^host[[:space:]]*=.*|host = \"127.0.0.1\"|" \
			-e "s|^port[[:space:]]*=.*|port = ${default_port}|" \
			-e "s|^baseUrl[[:space:]]*=.*|baseUrl = \"${url_base}/\"|" \
			-e "s|^logLevel[[:space:]]*=.*|logLevel = \"${log_level}\"|" \
			"${config_file}"
	fi
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

_secure() {
	local listen_port url
	listen_port="$(_get_toml_int "${data_dir}/config.toml" port)"
	url="http://127.0.0.1:${listen_port}${url_base}/"
	zenfw::request::wait::ping "${url}" 60 1000 false
	su -s /bin/bash -c "printf '%s\n%s\n%s\n' '${username}' '${user_password}' '${user_password}' | '${install_dir}/autobrrctl' --config '${data_dir}' create-user >/dev/null" - "${username}" || {
		printf '[autobrr] autobrrctl create-user failed for %s — set the password manually via the web UI\n' "${username}" >&2
		return 0
	}
}

_fetch_binary() {
	local tmpdir
	tmpdir="$(mktemp -d)"
	zenfw::git::release::get "${tmpdir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	mkdir -p "${install_dir}"
	if [[ -f "${tmpdir}/autobrr" ]]; then
		mv "${tmpdir}/autobrr" "${install_dir}/autobrr"
		[[ -f "${tmpdir}/autobrrctl" ]] && mv "${tmpdir}/autobrrctl" "${install_dir}/autobrrctl"
	else
		# tarball may extract flat or nested
		find "${tmpdir}" -type f \( -name autobrr -o -name autobrrctl \) -print0 | while IFS= read -r -d '' f; do
			mv "${f}" "${install_dir}/$(basename "${f}")"
		done
	fi
	chmod 0755 "${install_dir}/autobrr" "${install_dir}/autobrrctl"
	rm -rf "${tmpdir}"
}

_get_toml_int() {
	local file="$1" key="$2"
	awk -v k="${key}" '$1==k {gsub(/[ \t]/, ""); split($0, a, "="); print a[2]; exit}' "${file}"
}
