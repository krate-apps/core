+++ b/app/krate_middleware.py
@@ -0,0 +1,18 @@
+"""Krate reverse-proxy helpers (X-Forwarded-Prefix + ProxyFix)."""
+
+
+class ForwardedPrefixMiddleware:
+    """Strip Krate subpath from PATH_INFO; Caddy sends the full public path upstream."""
+
+    def __init__(self, app):
+        self.app = app
+
+    def __call__(self, environ, start_response):
+        prefix = (environ.get("HTTP_X_FORWARDED_PREFIX") or "").rstrip("/")
+        if prefix:
+            path = environ.get("PATH_INFO") or ""
+            if path == prefix or path.startswith(prefix + "/"):
+                environ["SCRIPT_NAME"] = prefix
+                rest = path[len(prefix) :] or "/"
+                environ["PATH_INFO"] = rest
+        return self.app(environ, start_response)
