#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/bazarr4k/bazarr4k
# @project KRATE
# @description Bazarr4K — same as bazarr (Python venv + YAML); separate instance for 4K
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::git::release::get "${install_dir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::workspace::venv::create "${install_dir}" "${username}" true
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local apikey default_port config_file hashed_password
	mkdir -p "${data_dir}/config" "${data_dir}/db" "${data_dir}/log"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	apikey="${service_apikey}"
	default_port="${service_default_port}"
	config_file="${data_dir}/config/config.yaml"
	[[ -f "${config_file}" ]] || printf 'auth:\n  type: form\ngeneral:\n  ip: 127.0.0.1\n' >"${config_file}"
	hashed_password="$(printf '%s' "${user_password}" | md5sum | awk '{print $1}')"
	zenfw::yaml::update_key "${config_file}" 'auth.type' 'form'
	zenfw::yaml::update_key "${config_file}" 'auth.username' "${username}"
	zenfw::yaml::update_key "${config_file}" 'auth.password' "${hashed_password}"
	zenfw::yaml::update_key "${config_file}" 'auth.apikey' "${apikey}"
	zenfw::yaml::update_key "${config_file}" 'general.ip' '127.0.0.1'
	zenfw::yaml::update_key "${config_file}" 'general.port' "${default_port}"
	zenfw::yaml::update_key "${config_file}" 'general.base_url' "${url_base}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	zenfw::git::release::get "${install_dir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::workspace::venv::create "${install_dir}" "${username}" true
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}
