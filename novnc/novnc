#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/novnc/novnc
# @project KRATE
# @description noVNC — TigerVNC (localhost SecurityTypes None) + websockify; wrapper ExecStart; Caddy proxy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	zenfw::dependency::apt::install_inline "novnc" "websockify" "tigervnc-standalone-server" || true
	command -v websockify >/dev/null 2>&1 || command -v websockify3 >/dev/null 2>&1 || {
		printf '[%s] websockify binary missing after apt install\n' "${app_name}" >&2
		return 1
	}
	command -v Xvnc >/dev/null 2>&1 || {
		printf '[%s] Xvnc binary missing after apt install\n' "${app_name}" >&2
		return 1
	}
	mkdir -p "${install_dir}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port vnc_port
	mkdir -p "${data_dir}" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	# Localhost-only RFB port (not proxied). Prefixed to stay clear of KRATE HTTP ports.
	vnc_port="1${default_port}"
	zenfw::fs::env::set "${env_file}" "PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "VNC_PORT" "${vnc_port}"
	zenfw::fs::env::set "${env_file}" "VNC_GEOMETRY" "1280x720"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	_write_novnc_run
	# SecurityTypes None is intentional: Xvnc binds localhost only; browser path is Caddy → websockify.
	# Optional desktop (xfce4) is omitted to keep the image light — empty X session is fine for noVNC.
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage start "${service_unit}" || zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	zenfw::dependency::apt::install_inline "novnc" "websockify" "tigervnc-standalone-server" || true
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_write_novnc_run() {
	cat >"${install_dir}/novnc-run" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
port="${PORT:?}"
vnc_port="${VNC_PORT:?}"
geometry="${VNC_GEOMETRY:-1280x720}"
web="/usr/share/novnc"
ws_bin="$(command -v websockify || command -v websockify3 || true)"
[[ -n "${ws_bin}" ]] || { echo "websockify not found" >&2; exit 1; }
xvnc_bin="$(command -v Xvnc || true)"
[[ -n "${xvnc_bin}" ]] || { echo "Xvnc not found" >&2; exit 1; }

cleanup() {
	local pids
	pids="$(jobs -p 2>/dev/null || true)"
	[[ -n "${pids}" ]] && kill ${pids} 2>/dev/null || true
	wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Localhost-only VNC. SecurityTypes None is intentional: RFB binds 127.0.0.1 only;
# the browser reaches the session via Caddy → websockify on PORT. Empty X is OK
# (optional apt xfce4 can be added later for a full desktop).
"${xvnc_bin}" \
	-rfbport "${vnc_port}" \
	-geometry "${geometry}" \
	-depth 24 \
	-SecurityTypes None \
	-localhost \
	-AlwaysShared \
	-desktop "KRATE noVNC" \
	&
sleep 1
exec "${ws_bin}" --web="${web}" "127.0.0.1:${port}" "127.0.0.1:${vnc_port}"
EOF
	chmod 0755 "${install_dir}/novnc-run"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
}
