#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps/listenarr/listenarr
# @project KRATE
# @description Listenarr — linux-x64.zip release binary; ASP.NET on loopback + Caddy.
# shellcheck disable=SC2154
set -euo pipefail

_add() {
	_fetch_binary
	zenfw::service::generate "${app_name}" true false
	_config
}

_config() {
	local default_port
	mkdir -p "${data_dir}/config" "$(dirname "${env_file}")"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	default_port="${service_default_port//[^0-9]/}"
	: "${default_port:?}"
	# Persist config under data_dir; binary expects ./config relative to WorkingDirectory.
	if [[ -d "${install_dir}/config" && ! -L "${install_dir}/config" ]]; then
		if [[ ! -e "${data_dir}/config/.seeded" ]]; then
			cp -a "${install_dir}/config/." "${data_dir}/config/" 2>/dev/null || true
			: >"${data_dir}/config/.seeded"
		fi
		rm -rf "${install_dir}/config"
	fi
	ln -sfn "${data_dir}/config" "${install_dir}/config"
	zenfw::fs::env::set "${env_file}" "ASPNETCORE_URLS" "http://127.0.0.1:${default_port}"
	zenfw::fs::env::set "${env_file}" "ASPNETCORE_ENVIRONMENT" "Production"
	zenfw::fs::env::set "${env_file}" "DOTNET_BUNDLE_EXTRACT_BASE_DIR" "/home/${username}/tmp/${app_name}"
	zenfw::permission::private::set "${env_file}" "${username}" "${username}"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	zenfw::proxy::generate "${app_name}" "${default_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	_fetch_binary
	_config
	zenfw::software::backup::create "${app_name}" "user" "${data_dir}" "${username}"
}

_fetch_binary() {
	local tmpdir src
	tmpdir="$(mktemp -d)"
	# Upstream currently ships only canary (GitHub prerelease) linux-x64.zip assets.
	zenfw::git::release::get "${tmpdir}" "${app_repo}" true "$(app::cfg install.release.asset)"
	if [[ -f "${tmpdir}/Listenarr.Api" ]]; then
		src="${tmpdir}"
	else
		src="$(find "${tmpdir}" -type f -name Listenarr.Api -printf '%h\n' -quit 2>/dev/null || true)"
	fi
	[[ -n "${src}" && -f "${src}/Listenarr.Api" ]] || {
		printf '[%s] Listenarr.Api missing after release extract\n' "${app_name}" >&2
		rm -rf "${tmpdir}"
		return 1
	}
	mkdir -p "${install_dir}"
	# Preserve config symlink under install_dir across updates.
	find "${install_dir}" -mindepth 1 -maxdepth 1 ! -name config -exec rm -rf {} + 2>/dev/null || true
	(
		cd "${src}"
		find . -mindepth 1 -maxdepth 1 ! -name config -exec cp -a {} "${install_dir}/" \;
	)
	chmod 0755 "${install_dir}/Listenarr.Api"
	zenfw::permission::read_exec::set "${install_dir}" "${username}" "${username}"
	rm -rf "${tmpdir}"
}
