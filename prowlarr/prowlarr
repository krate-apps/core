#!/usr/bin/env bash
[[ -n "${KRATE_HANDLER_CONTEXT_FILE:-}" && -f "${KRATE_HANDLER_CONTEXT_FILE}" ]] && . "${KRATE_HANDLER_CONTEXT_FILE}"
# @file applications/apps-official/prowlarr/prowlarr
# @project KRATE
# @description Prowlarr — app handler (aligned with community radarr)
# shellcheck disable=SC2154
set -euo pipefail

readonly _EVP=PROWLARR
readonly _API_CONFIG_HOST="api/v1/config/host"

_add() {
	zenfw::git::release::get "${install_dir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	zenfw::service::generate "${app_name}" true false
	_config
	_secure
}

_config() {
	local apikey default_port ssl_port update_branch
	mkdir -p "${data_dir}"
	zenfw::permission::read_exec::set "${data_dir}" "${username}" "${username}"
	apikey="${service_apikey}"
	default_port="${service_default_port}"
	ssl_port="${service_ssl_port}"
	update_branch="$(app::update_branch)"
	zenfw::fs::env::set "${env_file}" "${_EVP}__APP__INSTANCENAME" "${instance_name}"
	zenfw::fs::env::set "${env_file}" "${_EVP}__AUTH__APIKEY" "${apikey}"
	zenfw::fs::env::set "${env_file}" "${_EVP}__SERVER__PORT" "${default_port}"
	zenfw::fs::env::set "${env_file}" "${_EVP}__SERVER__SSLPORT" "${ssl_port}"
	zenfw::fs::env::set "${env_file}" "${_EVP}__SERVER__URLBASE" "${url_base}"
	zenfw::fs::env::set "${env_file}" "${_EVP}__UPDATE__BRANCH" "${update_branch}"
	local proxy_port
	proxy_port="$(zenfw::fs::env::get "${env_file}" "${_EVP}__SERVER__PORT")"
	zenfw::proxy::generate "${app_name}" "${proxy_port}" "${url_base}" true "${username}"
	zenfw::service::manage restart "${service_unit}"
}

_update() {
	zenfw::service::manage stop "${service_unit}"
	zenfw::git::release::get "${install_dir}" "${app_repo}" "${is_prerelease}" "$(app::cfg install.release.asset)"
	zenfw::service::manage restart "${service_unit}"
	zenfw::software::backup::create "${app_name}" "user" "${install_dir}" "${username}"
}

_secure() {
	local url api_url cfg json_payload api_key listen_port update_branch
	api_key="$(zenfw::fs::env::get "${env_file}" "${_EVP}__AUTH__APIKEY")"
	listen_port="$(zenfw::fs::env::get "${env_file}" "${_EVP}__SERVER__PORT")"
	update_branch="$(zenfw::fs::env::get "${env_file}" "${_EVP}__UPDATE__BRANCH")"
	url="http://localhost:${listen_port}/${username}/${app_name}/"
	zenfw::request::wait::ping "${url}" 60 1000 true
	api_url="${url}${_API_CONFIG_HOST}"
	cfg="$(API_SERVICE_APIKEY="${api_key}" zenfw::request::app::get "${api_url}" true "X-API-KEY")"
	json_payload="$(zenfw::json::merge "${cfg}" \
		username "${username}" \
		password "${user_password}" \
		passwordConfirmation "${user_password}" \
		authenticationMethod "forms" \
		authenticationRequired "disabledForLocalAddresses" \
		branch "${update_branch}" \
		apiKey "${api_key}" \
		urlBase "${url_base}" \
		instanceName "${instance_name}")"
	API_SERVICE_APIKEY="${api_key}" zenfw::request::app::save "${api_url}" "PUT" "${json_payload}"
}
